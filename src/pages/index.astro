---
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import resume from '../assets/resume.pdf';
import trophy from '../assets/trophy.svg';
import twitter from '../assets/X.svg';
import Profile from '../components/Profile.astro';
import Experience from '../components/Experience.astro';
import Showcase from '../components/Showcase.astro';
import Education from '../components/Education.astro';
import GitLog from '../components/GitLog.astro';
import XPosts from '../components/XPosts.astro';
import EasterEgg from '../components/EasterEgg.astro';
import CommandPalette from '../components/CommandPalette.astro';

import CodePlayground from '../components/CodePlayground.astro';

---

<Layout title="Mohammad Anas">
  <Header active='/'/>
  <CommandPalette />
  <div class="scroll-progress" id="scroll-progress"></div>

  <main class="main-content">
    <!-- ═══════════════ HERO SECTION ═══════════════ -->
    <section class="hero">
      <div class="hero-grid container-bg">
        <div class="hero-left">
          <p class="hero-comment">// hello world</p>
          <h1 class="hero-name">I AM <span class="hero-accent">ANAS</span></h1>
          <h2 class="hero-role">A <span id="typewritter-text"></span></h2>

          <p class="hero-tagline" id="hero-tagline">
            <span class="tagline-prompt">&gt;</span>
            <span id="tagline-light">engineering products that ship to millions</span>
            <span id="tagline-dark" style="display:none;">experimenting with AI, 3D worlds & blockchain after dark</span>
          </p>

          <div class="hero-actions">
            <a href={resume} target="_blank" class="resume-btn">
              <span class="btn-prompt">$</span> cat resume.pdf
            </a>
          </div>

          <div class="npx-badge" id="npx-badge" title="Click to copy">
            <span class="npx-prompt">$</span> npx mohdanas
            <span class="npx-copied" id="npx-copied">copied!</span>
          </div>
        </div>

        <div class="hero-right">
          <!-- Terminal widget with 3D tilt -->
          <div class="hero-terminal" id="hero-terminal">
            <div class="term-bar">
              <div class="term-dots">
                <span class="dot dot-r"></span>
                <span class="dot dot-y"></span>
                <span class="dot dot-g"></span>
              </div>
              <span class="term-title">anas@dev:~</span>
            </div>
            <div class="term-body">
              <div class="term-line"><span class="t-prompt">anas@dev:~$</span> whoami</div>
              <div class="term-line t-output">Software Engineer @ Adobe</div>
              <div class="term-line"><span class="t-prompt">anas@dev:~$</span> uptime</div>
              <div class="term-line t-output">4+ years shipping code</div>
              <div class="term-line"><span class="t-prompt">anas@dev:~$</span> ls skills/</div>
              <div class="term-line t-output">js ts react c++ node python solidity</div>
              <div class="term-line"><span class="t-prompt">anas@dev:~$</span> <span class="terminal-cursor"></span></div>
            </div>
          </div>

          <!-- Social icons below terminal -->
          <div class="hero-social">
            <a target="_blank" href="https://x.com/anaslyzer" aria-label="Twitter"><Image src={twitter} class="social-icon-img" alt="Twitter"/></a>
            <a target="_blank" href="https://www.github.com/anasM0hammad" aria-label="GitHub"><i class="fab fa-github"></i></a>
            <a target="_blank" href="https://www.linkedin.com/in/anasm0hammad/" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a target="_blank" href="https://www.instagram.com/anaslyzer.music/" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ PRODUCTS ═══════════════ -->
    <div class="reveal"><Showcase /></div>

    <!-- ═══════════════ PROFILE ═══════════════ -->
    <div class="reveal"><Profile /></div>

    <!-- ═══════════════ X / TWITTER ═══════════════ -->
    <div class="reveal"><XPosts /></div>

    <!-- ═══════════════ CODE PLAYGROUND ═══════════════ -->
    <div class="reveal"><CodePlayground /></div>

    <!-- ═══════════════ EXPERIENCE ═══════════════ -->
    <div class="reveal"><Experience /></div>

    <!-- ═══════════════ GIT LOG ═══════════════ -->
    <div class="reveal"><GitLog /></div>

    <!-- ═══════════════ ACHIEVEMENTS ═══════════════ -->
    <section class="achievements-section">
      <div class="container-bg">
        <h3 class="section-header">
          <span class="prompt">&gt;</span> cat achievements.md<span class="terminal-cursor"></span>
        </h3>

        <div class="ach-grid">
          <div class="ach-card">
            <div class="ach-icon"><Image src={trophy} class="trophy-img" alt="Trophy"/></div>
            <div class="ach-list">
              <div class="ach-item">
                <span class="ach-bullet">*</span>
                <span><b>Tech Significance Award</b> of the quarter in Adobe Q4 2024</span>
              </div>
              <div class="ach-item">
                <span class="ach-bullet">*</span>
                <span><b>Kudos Award</b> of the quarter in Adobe Q1 2022</span>
              </div>
              <div class="ach-item">
                <span class="ach-bullet">*</span>
                <span>Qualified for <b>ACM ICPC</b> regionals in 2017</span>
              </div>
              <div class="ach-item">
                <span class="ach-bullet">*</span>
                <span>Qualified <b>Advance level</b> DSA test in Samsung</span>
              </div>
              <div class="ach-item">
                <span class="ach-bullet">*</span>
                <span>In <b>Top 100</b> Solidity developers of India by CodersRank</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════ EDUCATION ═══════════════ -->
    <div class="reveal"><Education /></div>

    <!-- ═══════════════ FOOTER ═══════════════ -->
    <Footer />
  </main>

  <!-- ═══════════════ EASTER EGG ═══════════════ -->
  <EasterEgg />
</Layout>

<script>
  // Theme-aware tagline
  function updateTagline() {
    const theme = document.documentElement.getAttribute('data-theme');
    const lightEl = document.getElementById('tagline-light');
    const darkEl = document.getElementById('tagline-dark');
    if (lightEl && darkEl) {
      if (theme === 'dark') {
        lightEl.style.display = 'none';
        darkEl.style.display = 'inline';
      } else {
        lightEl.style.display = 'inline';
        darkEl.style.display = 'none';
      }
    }
  }

  updateTagline();
  const taglineObserver = new MutationObserver(updateTagline);
  taglineObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // npx badge copy
  document.getElementById('npx-badge')?.addEventListener('click', () => {
    navigator.clipboard.writeText('npx mohdanas').then(() => {
      const copied = document.getElementById('npx-copied');
      if (copied) {
        copied.classList.add('show');
        setTimeout(() => copied.classList.remove('show'), 1500);
      }
    });
  });

  // 3D tilt effect on terminal
  const heroTerminal = document.getElementById('hero-terminal');
  if (heroTerminal) {
    heroTerminal.addEventListener('mousemove', (e) => {
      const rect = heroTerminal.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      const rotateY = (x - 0.5) * 8;
      const rotateX = (0.5 - y) * 8;
      heroTerminal.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      heroTerminal.style.transition = 'none';
    });

    heroTerminal.addEventListener('mouseleave', () => {
      heroTerminal.style.transition = 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      heroTerminal.style.transform = 'perspective(800px) rotateX(0) rotateY(0)';
    });
  }

  // Scroll progress bar
  const scrollProgress = document.getElementById('scroll-progress');
  if (scrollProgress) {
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      scrollProgress.style.width = `${progress}%`;
    });
  }

  // Scroll reveal: IntersectionObserver
  const revealElements = document.querySelectorAll('.reveal');
  if (revealElements.length > 0) {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    revealElements.forEach((el) => revealObserver.observe(el));
  }

  // Console ASCII art Easter egg
  console.log(
    '%c' +
    '╔═══════════════════════════════════════════╗\n' +
    '║                                           ║\n' +
    '║    █████╗ ███╗   ██╗ █████╗ ███████╗      ║\n' +
    '║   ██╔══██╗████╗  ██║██╔══██╗██╔════╝      ║\n' +
    '║   ███████║██╔██╗ ██║███████║███████╗       ║\n' +
    '║   ██╔══██║██║╚██╗██║██╔══██║╚════██║      ║\n' +
    '║   ██║  ██║██║ ╚████║██║  ██║███████║      ║\n' +
    '║   ╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚═╝╚══════╝      ║\n' +
    '║                                           ║\n' +
    '║   Hey hacker! Try the Konami code ;)      ║\n' +
    '║   ↑ ↑ ↓ ↓ ← → ← → B A                   ║\n' +
    '║                                           ║\n' +
    '╚═══════════════════════════════════════════╝',
    'color: #C04848; font-family: monospace; font-size: 11px;'
  );
  console.log(
    '%c> Curious dev? Check out the source: github.com/anasM0hammad',
    'color: #7ee787; font-family: monospace; font-size: 12px;'
  );
</script>

<style>
  .main-content {
    padding-top: 60px;
  }

  /* ============================================
     HERO SECTION
     ============================================ */
  .hero {
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    padding: 2rem 0;
    background: var(--bg-primary);
    transition: background-color 0.3s ease;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-comment {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  .hero-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-accent {
    color: var(--accent);
  }

  .hero-role {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0.5rem 0 1rem 0;
  }

  .hero-tagline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin: 0 0 1.5rem 0;
    line-height: 1.5;
  }

  .tagline-prompt {
    color: var(--accent);
    margin-right: 0.35rem;
  }

  .hero-actions {
    margin-bottom: 1rem;
  }

  .resume-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-inverse);
    background: var(--accent);
    border: none;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .resume-btn:hover {
    background: var(--accent-hover);
    color: var(--text-inverse);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--accent-glow);
  }

  .btn-prompt {
    opacity: 0.7;
  }

  .npx-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--terminal-text);
    background: var(--terminal-bg);
    border: 1px solid var(--terminal-border);
    padding: 0.35rem 0.75rem;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    width: fit-content;
    margin-bottom: 1.5rem;
  }

  .npx-badge:hover {
    border-color: var(--accent);
  }

  .npx-prompt {
    color: var(--terminal-green);
  }

  .npx-copied {
    position: absolute;
    right: -60px;
    font-size: 0.68rem;
    color: var(--terminal-green);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .npx-copied.show {
    opacity: 1;
  }

  /* ============================================
     HERO RIGHT - Terminal + Social
     ============================================ */
  .hero-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-terminal {
    width: 100%;
    max-width: 420px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--terminal-border);
    background: var(--terminal-bg);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    will-change: transform;
    transform-style: preserve-3d;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: #161b22;
    border-bottom: 1px solid var(--terminal-border);
  }

  .term-dots {
    display: flex;
    gap: 5px;
  }

  .dot { width: 9px; height: 9px; border-radius: 50%; }
  .dot-r { background: #ff5f56; }
  .dot-y { background: #ffbd2e; }
  .dot-g { background: #27c93f; }

  .term-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: #8b949e;
  }

  .term-body {
    padding: 0.75rem 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .term-line {
    color: var(--terminal-text);
  }

  .t-prompt {
    color: var(--terminal-green);
    margin-right: 0.4rem;
  }

  .t-output {
    color: #8b949e;
    padding-left: 0.5rem;
  }

  /* Social icons below terminal */
  .hero-social {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-social a {
    color: var(--text-muted);
    font-size: 1.5rem;
    transition: all 0.2s ease;
  }

  .hero-social a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .social-icon-img {
    height: 24px;
    width: 24px;
    vertical-align: middle;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .hero-social a:hover .social-icon-img {
    opacity: 1;
  }

  /* ============================================
     ACHIEVEMENTS SECTION
     ============================================ */
  .achievements-section {
    padding: 4rem 0;
    background: var(--bg-primary);
    transition: background-color 0.3s ease;
  }

  .ach-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ach-card {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .ach-card:hover {
    border-color: var(--accent);
    box-shadow: var(--card-shadow);
  }

  .ach-icon {
    flex-shrink: 0;
  }

  .trophy-img {
    width: 64px;
    height: 64px;
  }

  .ach-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ach-item {
    display: flex;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .ach-bullet {
    color: var(--accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 768px) {
    .hero {
      padding: 1.5rem 0;
      min-height: auto;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hero-name {
      font-size: 2.5rem;
    }

    .hero-role {
      font-size: 1.2rem;
    }

    .hero-tagline {
      font-size: 0.78rem;
    }

    .hero-right {
      order: -1;
    }

    .hero-terminal {
      max-width: 100%;
    }

    .hero-comment {
      font-size: 0.8rem;
    }

    .resume-btn {
      font-size: 0.8rem;
      padding: 0.55rem 1rem;
    }

    .npx-badge {
      font-size: 0.7rem;
    }

    .hero-social a {
      font-size: 1.25rem;
    }

    .social-icon-img {
      height: 20px;
      width: 20px;
    }

    .term-body {
      font-size: 0.7rem;
      padding: 0.6rem 0.75rem;
    }

    .ach-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 1.25rem;
    }

    .trophy-img {
      width: 48px;
      height: 48px;
    }

    .ach-item {
      font-size: 0.82rem;
    }

    .achievements-section {
      padding: 3rem 0;
    }
  }

  @media (max-width: 480px) {
    .hero-name {
      font-size: 2rem;
    }

    .hero-role {
      font-size: 1rem;
    }

    .hero-tagline {
      font-size: 0.72rem;
    }

    .npx-copied {
      right: -50px;
      font-size: 0.6rem;
    }

    .ach-item {
      font-size: 0.78rem;
    }

    .ach-card {
      padding: 1rem;
    }
  }
</style>
