---
// buffai-privacy-policy.astro
const pageTitle = "BuffAI - Privacy Policy";
const lastUpdated = "June 6, 2026";
---

<html class="light scroll-smooth" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />

    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-primary: #E8352A;
            --color-background-light: #f6f6f8;
            --color-background-dark: #0A0A0A;
            --color-text-dark: #111318;
            --color-text-gray: #616f89;
            --color-text-slate: #334155;
            --color-border-light: #f0f2f4;
            --color-white: #ffffff;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--color-background-light);
            color: var(--color-text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        /* Header Styles */
        .header {
            position: sticky;
            top: 0;
            z-index: 50;
            width: 100%;
            background-color: var(--color-white);
            border-bottom: 1px solid var(--color-border-light);
            transition: all 0.2s;
        }

        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1.5rem;
            max-width: 1280px;
            margin: 0 auto;
            width: 100%;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: var(--color-text-dark);
        }

        .logo-icon {
            width: 2rem;
            height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-primary);
        }

        .logo-text {
            font-size: 1.125rem;
            font-weight: 700;
            line-height: 1.25;
            letter-spacing: -0.015em;
        }

        .nav-desktop {
            display: none;
            flex: 1;
            justify-content: flex-end;
            gap: 2rem;
            align-items: center;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2.25rem;
        }

        .nav-link {
            color: var(--color-text-dark);
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s;
        }

        .nav-link:hover {
            color: var(--color-primary);
        }

        .btn-download {
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 0.5rem;
            height: 2.5rem;
            padding: 0 1.5rem;
            background-color: var(--color-primary);
            color: white;
            font-size: 0.875rem;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: background-color 0.2s;
            box-shadow: 0 10px 15px -3px rgba(232, 53, 42, 0.2);
        }

        .btn-download:hover {
            background-color: #c42d22;
        }

        .mobile-menu-btn {
            display: block;
            color: var(--color-text-dark);
            background: none;
            border: none;
            cursor: pointer;
        }

        @media (min-width: 768px) {
            .nav-desktop {
                display: flex;
            }
            .mobile-menu-btn {
                display: none;
            }
        }

        @media (min-width: 1024px) {
            .header-container {
                padding: 0.75rem 2.5rem;
            }
        }

        /* Main Content */
        .main-content {
            flex-grow: 1;
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 2.5rem 1.5rem;
        }

        .content-wrapper {
            display: flex;
            flex-direction: column;
            gap: 3rem;
        }

        @media (min-width: 1024px) {
            .content-wrapper {
                flex-direction: row;
            }
            .main-content {
                padding: 2.5rem 2.5rem;
            }
        }

        /* Sidebar */
        .sidebar {
            display: none;
            width: 16rem;
            flex-shrink: 0;
        }

        @media (min-width: 1024px) {
            .sidebar {
                display: block;
            }
        }

        .sidebar-sticky {
            position: sticky;
            top: 7rem;
        }

        .sidebar-title {
            font-size: 0.875rem;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 1rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .sidebar-link {
            color: #475569;
            font-size: 0.875rem;
            padding: 0.5rem 1rem;
            border-left: 2px solid transparent;
            text-decoration: none;
            transition: all 0.2s;
        }

        .sidebar-link:hover {
            color: var(--color-primary);
            border-left-color: rgba(232, 53, 42, 0.3);
        }

        .sidebar-link.active {
            color: var(--color-primary);
            font-weight: 500;
            border-left-color: var(--color-primary);
        }

        /* Article Card */
        .article {
            flex: 1;
            min-width: 0;
        }

        .article-card {
            background-color: var(--color-white);
            border-radius: 0.75rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
            padding: 1.5rem;
        }

        @media (min-width: 768px) {
            .article-card {
                padding: 3rem;
            }
        }

        /* Page Header */
        .page-header {
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 2rem;
            margin-bottom: 2rem;
        }

        .header-content {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .page-title {
            color: var(--color-text-dark);
            font-size: 2.25rem;
            font-weight: 900;
            line-height: 1.2;
            letter-spacing: -0.033em;
        }

        @media (min-width: 768px) {
            .page-title {
                font-size: 3rem;
            }
        }

        .header-meta {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .badge {
            background-color: rgba(232, 53, 42, 0.1);
            color: var(--color-primary);
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .last-updated {
            color: var(--color-text-gray);
            font-size: 0.875rem;
            font-weight: 500;
        }

        /* Sections */
        .section {
            margin-bottom: 2.5rem;
            scroll-margin-top: 7rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .icon-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            border-radius: 0.25rem;
            background-color: rgba(232, 53, 42, 0.1);
            color: var(--color-primary);
        }

        .section-title {
            color: var(--color-text-dark);
            font-size: 1.5rem;
            font-weight: 700;
            line-height: 1.25;
        }

        .section-text {
            color: var(--color-text-slate);
            font-size: 1rem;
            line-height: 1.625;
            margin-bottom: 1rem;
        }

        .intro-text {
            color: var(--color-text-gray);
            font-size: 1rem;
            line-height: 1.625;
        }

        @media (min-width: 768px) {
            .intro-text {
                font-size: 1.125rem;
            }
        }

        .section-list {
            list-style-type: disc;
            padding-left: 1.25rem;
            color: var(--color-text-slate);
            margin-bottom: 1rem;
        }

        .section-list li {
            margin-bottom: 0.5rem;
        }

        /* Subsection */
        .subsection {
            margin-top: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .subsection-title {
            color: var(--color-text-dark);
            font-size: 1.125rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }

        /* Alert Box */
        .alert {
            background-color: #fff5f5;
            border-left: 4px solid var(--color-primary);
            padding: 1rem;
            border-radius: 0 0.25rem 0.25rem 0;
            margin-bottom: 1rem;
        }

        .alert-text {
            font-size: 0.875rem;
            color: #9b1c1c;
            font-weight: 500;
        }

        /* Data Table */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1rem;
            font-size: 0.875rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .data-table thead {
            background-color: #f8fafc;
        }

        .data-table th {
            text-align: left;
            padding: 0.75rem 1rem;
            font-weight: 700;
            color: var(--color-text-dark);
            border-bottom: 2px solid #e2e8f0;
        }

        .data-table td {
            padding: 0.75rem 1rem;
            color: var(--color-text-slate);
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
            line-height: 1.5;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        @media (max-width: 767px) {
            .data-table {
                display: block;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
        }

        /* Permission Cards */
        .permission-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        @media (min-width: 768px) {
            .permission-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .permission-card {
            padding: 1rem;
            border-radius: 0.25rem;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
        }

        .permission-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
            font-weight: 700;
            color: var(--color-text-dark);
        }

        .permission-text {
            font-size: 0.875rem;
            color: #475569;
        }

        /* Rights List */
        .rights-list {
            list-style-type: none;
            padding-left: 0;
            color: var(--color-text-slate);
            margin-bottom: 1rem;
        }

        .rights-list li {
            margin-bottom: 0.75rem;
            padding-left: 1.5rem;
            position: relative;
        }

        .rights-list li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--color-primary);
            font-weight: 700;
        }

        /* Contact Box */
        .contact-box {
            background-color: var(--color-background-light);
            padding: 1.5rem;
            border-radius: 0.5rem;
            border: 1px solid #cbd5e1;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .contact-box {
                flex-direction: row;
                align-items: center;
            }
        }

        .contact-item {
            flex: 1;
        }

        .contact-label {
            font-size: 0.875rem;
            color: #64748b;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.25rem;
        }

        .contact-link {
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--color-primary);
            text-decoration: none;
        }

        .contact-link:hover {
            text-decoration: underline;
        }

        /* Footer */
        .footer {
            background-color: var(--color-white);
            border-top: 1px solid var(--color-border-light);
            padding: 2.5rem 0;
            margin-top: auto;
        }

        .footer-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .footer-container {
                flex-direction: row;
            }
        }

        @media (min-width: 1024px) {
            .footer-container {
                padding: 0 2.5rem;
            }
        }

        .footer-brand {
            text-align: center;
        }

        @media (min-width: 768px) {
            .footer-brand {
                text-align: left;
            }
        }

        .footer-title {
            color: var(--color-text-dark);
            font-weight: 700;
            font-size: 1.125rem;
            margin-bottom: 0.25rem;
        }

        .footer-copyright {
            color: #64748b;
            font-size: 0.875rem;
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
        }

        .footer-link {
            color: #475569;
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-link:hover {
            color: var(--color-primary);
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="logo-section">
                <div class="logo-icon">
                    <span class="material-symbols-outlined" style="font-size: 1.875rem;">fitness_center</span>
                </div>
                <h2 class="logo-text">BuffAI</h2>
            </div>
            <div class="nav-desktop">
                <nav class="nav-links">
                    <a class="nav-link" href="/">Home</a>
                    <a class="nav-link" href="mailto:info@mohdanas.me">Support</a>
                </nav>
                <button class="btn-download">
                    <span>Download App</span>
                </button>
            </div>
            <button class="mobile-menu-btn">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <div class="content-wrapper">
            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="sidebar-sticky">
                    <h3 class="sidebar-title">Table of Contents</h3>
                    <nav class="sidebar-nav">
                        <a class="sidebar-link active" href="#introduction">Introduction</a>
                        <a class="sidebar-link" href="#info-collect">1. Information We Collect</a>
                        <a class="sidebar-link" href="#how-we-use">2. How We Use Information</a>
                        <a class="sidebar-link" href="#permissions">3. Device Permissions</a>
                        <a class="sidebar-link" href="#firebase">4. Firebase Services</a>
                        <a class="sidebar-link" href="#advertising">5. Advertising</a>
                        <a class="sidebar-link" href="#third-party">6. Third-Party Services</a>
                        <a class="sidebar-link" href="#security">7. Data Storage & Security</a>
                        <a class="sidebar-link" href="#data-retention">8. Data Retention</a>
                        <a class="sidebar-link" href="#children">9. Children's Privacy</a>
                        <a class="sidebar-link" href="#rights">10. Your Rights & Choices</a>
                        <a class="sidebar-link" href="#international">11. International Users</a>
                        <a class="sidebar-link" href="#changes">12. Changes to This Policy</a>
                        <a class="sidebar-link" href="#contact">13. Contact Us</a>
                    </nav>
                </div>
            </aside>

            <!-- Article -->
            <article class="article">
                <div class="article-card">
                    <!-- Page Header -->
                    <div class="page-header">
                        <div class="header-content">
                            <h1 class="page-title">Privacy Policy</h1>
                            <div class="header-meta">
                                <span class="badge">Legal</span>
                                <p class="last-updated">Last Updated: {lastUpdated}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Introduction -->
                    <div class="section" id="introduction">
                        <p class="intro-text">
                            Thank you for using <strong>BuffAI</strong> ("the App"), a dead-simple gym workout logger developed by Gravity Lab ("we", "us", or "our"). BuffAI helps you log your sets, track the weight you lifted, and see exactly what you did last session — so you can focus on getting stronger, not on memorising numbers. This Privacy Policy explains what information we collect, how we use it, and what choices you have. Please read it carefully. By downloading, installing, or using the App, you agree to the practices described in this policy. If you do not agree, please do not use the App.
                        </p>
                    </div>

                    <!-- Section 1: Information We Collect -->
                    <div class="section" id="info-collect">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">info</span>
                            </span>
                            <h2 class="section-title">1. Information We Collect</h2>
                        </div>
                        <p class="section-text">
                            BuffAI is built with a <strong>local-first, privacy-first</strong> architecture. We do not require account creation, login, or any form of user registration. We do not collect personally identifiable information such as your real name, email address, phone number, or physical address.
                        </p>

                        <div class="subsection">
                            <h3 class="subsection-title">a. Information Stored Locally on Your Device</h3>
                            <p class="section-text">
                                The App stores all workout data exclusively on your device in a local SQLite database (via the Drift library). This data never leaves your device and is never transmitted to our servers. Locally stored data includes:
                            </p>
                            <ul class="section-list">
                                <li><strong>Workout Logs:</strong> Exercise names, number of sets, reps per set, weight per set, and the date and time each workout was performed.</li>
                                <li><strong>Exercise Library:</strong> Custom exercises you create, including their name and muscle group category.</li>
                                <li><strong>Workout History:</strong> A complete history of all logged sessions used to display your previous performance when you start a new session.</li>
                                <li><strong>Progress Data:</strong> Aggregated historical sets used to render volume and strength progression charts within the App.</li>
                                <li><strong>User Settings:</strong> App preferences such as selected language, theme, unit system (kg/lbs), and notification preferences — stored via SharedPreferences.</li>
                            </ul>
                            <div class="alert">
                                <p class="alert-text">All workout data is stored locally on your device only. We do not operate any servers that collect or store this data. Uninstalling the App removes all locally stored data from your device.</p>
                            </div>
                        </div>

                        <div class="subsection">
                            <h3 class="subsection-title">b. Information Collected by Third-Party Services</h3>
                            <p class="section-text">
                                The App integrates third-party services (Firebase and Google AdMob) that may collect certain device-level information automatically. This data is collected and processed by those third parties in accordance with their own privacy policies. See Sections 4, 5, and 6 for full details.
                            </p>
                        </div>

                        <div class="subsection">
                            <h3 class="subsection-title">c. Information We Do NOT Collect</h3>
                            <p class="section-text">
                                To be clear about the scope of our data practices, we do not collect:
                            </p>
                            <ul class="section-list">
                                <li>Names, email addresses, phone numbers, or physical addresses</li>
                                <li>Location data or GPS coordinates</li>
                                <li>Photos, videos, or media files</li>
                                <li>Contact lists or call logs</li>
                                <li>Browsing history or search queries</li>
                                <li>Financial or payment information</li>
                                <li>Biometric data (fingerprints, face scans, voice recordings)</li>
                                <li>Health data from platform health APIs (Apple Health, Google Fit)</li>
                                <li>Contents of your messages or communications</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Section 2: How We Use Information -->
                    <div class="section" id="how-we-use">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">analytics</span>
                            </span>
                            <h2 class="section-title">2. How We Use Information</h2>
                        </div>
                        <p class="section-text">
                            All locally stored data is used solely to provide and improve the core functionality of the App. Specifically:
                        </p>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>How It Is Used</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Workout logs (sets, reps, weight)</td>
                                    <td>Displayed on the active workout screen so you can see exactly what you lifted last session and log your new performance</td>
                                </tr>
                                <tr>
                                    <td>Workout history</td>
                                    <td>Powers the history view and the "last time" reference shown when you add a set, helping you apply progressive overload</td>
                                </tr>
                                <tr>
                                    <td>Progress data</td>
                                    <td>Aggregated on-device to render volume and strength progression charts so you can visualise your improvements over time</td>
                                </tr>
                                <tr>
                                    <td>Exercise library</td>
                                    <td>Allows you to select and reuse exercises across workouts without re-entering details each time</td>
                                </tr>
                                <tr>
                                    <td>User settings</td>
                                    <td>Persists your preferences (unit system, language, theme) so the App behaves consistently across sessions</td>
                                </tr>
                                <tr>
                                    <td>Notification preferences</td>
                                    <td>Schedules optional rest-timer and workout-reminder notifications at the times you configure</td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="section-text">
                            We do <strong>NOT</strong> use your data for:
                        </p>
                        <ul class="section-list">
                            <li>Advertising targeting or personalised ad profiling based on your workout data</li>
                            <li>Selling or transferring your workout data to third parties</li>
                            <li>Training AI or machine learning models</li>
                            <li>Credit assessment or lending decisions</li>
                            <li>Any purpose unrelated to workout logging and progress tracking</li>
                        </ul>
                    </div>

                    <!-- Section 3: Device Permissions -->
                    <div class="section" id="permissions">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">security</span>
                            </span>
                            <h2 class="section-title">3. Device Permissions</h2>
                        </div>
                        <p class="section-text">
                            The App requests the following device permissions. Each permission is used solely for the purpose described:
                        </p>
                        <div class="permission-grid">
                            <div class="permission-card">
                                <div class="permission-header">
                                    <span class="material-symbols-outlined" style="color: var(--color-primary);">wifi</span>
                                    <span>Internet Access</span>
                                </div>
                                <p class="permission-text">Required to load advertisements via Google AdMob and to send anonymised crash and analytics events to Firebase. Workout data is never transmitted over the internet.</p>
                            </div>
                            <div class="permission-card">
                                <div class="permission-header">
                                    <span class="material-symbols-outlined" style="color: var(--color-primary);">notifications</span>
                                    <span>Notifications</span>
                                </div>
                                <p class="permission-text">Used to display optional rest-timer alerts during a workout and workout-reminder notifications at times you set. Required on Android 13+ devices. You can disable notifications at any time in your device settings.</p>
                            </div>
                            <div class="permission-card">
                                <div class="permission-header">
                                    <span class="material-symbols-outlined" style="color: var(--color-primary);">folder_open</span>
                                    <span>Storage / File Access</span>
                                </div>
                                <p class="permission-text">Used when you choose to export your workout history to a file or import a previously saved backup. The App only reads or writes the file you explicitly select via the system file picker.</p>
                            </div>
                            <div class="permission-card">
                                <div class="permission-header">
                                    <span class="material-symbols-outlined" style="color: var(--color-primary);">share</span>
                                    <span>Share</span>
                                </div>
                                <p class="permission-text">Used when you choose to share a workout summary or progress chart via your device's native share sheet. Sharing is always initiated by you — nothing is shared automatically.</p>
                            </div>
                        </div>
                        <div class="alert">
                            <p class="alert-text">The App does not access your camera, microphone, contacts, location, calendar, photos, or any other sensitive device features beyond those listed above.</p>
                        </div>
                    </div>

                    <!-- Section 4: Firebase Services -->
                    <div class="section" id="firebase">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">cloud</span>
                            </span>
                            <h2 class="section-title">4. Firebase Services</h2>
                        </div>
                        <p class="section-text">
                            The App integrates two Firebase services provided by Google: Firebase Crashlytics and Firebase Analytics. Neither service receives your personal workout data.
                        </p>

                        <div class="subsection">
                            <h3 class="subsection-title">4.1 Firebase Crashlytics</h3>
                            <p class="section-text">
                                We use Firebase Crashlytics to detect, diagnose, and fix stability issues in the App. When the App crashes or encounters an unhandled error, Crashlytics automatically sends an anonymised crash report to Google's servers. This report includes:
                            </p>
                            <ul class="section-list">
                                <li>The stack trace and error message at the point of crash</li>
                                <li>Device model, operating system version, and App version</li>
                                <li>A randomly generated installation identifier (not linked to your identity)</li>
                                <li>The sequence of screens visited before the crash (no personal data within those screens)</li>
                            </ul>
                            <p class="section-text">
                                Crashlytics reports never contain your workout data, exercise names, or any other content you entered into the App.
                            </p>
                        </div>

                        <div class="subsection">
                            <h3 class="subsection-title">4.2 Firebase Analytics</h3>
                            <p class="section-text">
                                We use Firebase Analytics to understand how users interact with the App at an aggregate level, so we can make informed decisions about which features to improve or add. Analytics collects:
                            </p>
                            <ul class="section-list">
                                <li>Anonymised screen views and navigation events (e.g., "opened history screen")</li>
                                <li>Custom in-app events (e.g., "workout started", "exercise added") — these events do <strong>not</strong> include the specific exercise names, weights, or reps you log</li>
                                <li>Session duration and App engagement metrics</li>
                                <li>Device type, operating system, and App version</li>
                                <li>Country and language settings (region-level, not precise location)</li>
                            </ul>
                            <div class="alert">
                                <p class="alert-text">Firebase Analytics data is aggregated and anonymised. Your personal workout logs, exercise library, and progress data are never sent to Firebase. You can opt out of Analytics data collection by adjusting the "Analytics" toggle in the App's settings.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Section 5: Advertising -->
                    <div class="section" id="advertising">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">ads_click</span>
                            </span>
                            <h2 class="section-title">5. Advertising</h2>
                        </div>
                        <p class="section-text">
                            BuffAI is free to download and is supported by advertisements served through <strong>Google AdMob</strong>. The App may display interstitial ads at natural transition points — for example, after completing a workout session or returning to the home screen.
                        </p>
                        <p class="section-text">
                            Google AdMob may collect device identifiers, IP address, and usage data to serve and measure advertisements. For users in the European Economic Area (EEA), we implement Google's User Messaging Platform (UMP) to obtain your consent before serving personalised advertisements. If you decline consent, you will only receive non-personalised ads.
                        </p>
                        <p class="section-text">
                            For more information about how Google uses advertising data, please visit: <a href="https://policies.google.com/privacy" style="color: var(--color-primary);">Google Privacy Policy</a>.
                        </p>
                        <div class="alert">
                            <p class="alert-text">Your workout data, exercise logs, and progress charts are never shared with AdMob or used for ad targeting. Ad personalisation is based solely on device-level signals collected by Google.</p>
                        </div>
                    </div>

                    <!-- Section 6: Third-Party Services -->
                    <div class="section" id="third-party">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">hub</span>
                            </span>
                            <h2 class="section-title">6. Third-Party Services</h2>
                        </div>
                        <p class="section-text">
                            The App integrates the following third-party services. Each operates under its own privacy policy, which we encourage you to review:
                        </p>
                        <ul class="section-list">
                            <li><strong>Google AdMob:</strong> Displays interstitial advertisements to support the free App. AdMob may collect device identifiers, IP address, and usage data. <a href="https://policies.google.com/privacy" style="color: var(--color-primary);">Google Privacy Policy</a></li>
                            <li><strong>Firebase Crashlytics:</strong> Receives anonymised crash reports to help us fix stability issues. No personal or workout data is included. <a href="https://firebase.google.com/support/privacy" style="color: var(--color-primary);">Firebase Privacy</a></li>
                            <li><strong>Firebase Analytics:</strong> Receives anonymised usage events to help us understand feature adoption. No personal or workout data is included. <a href="https://firebase.google.com/support/privacy" style="color: var(--color-primary);">Firebase Privacy</a></li>
                            <li><strong>Google Play Services:</strong> Required for App distribution, in-app review prompts, and platform integration on Android devices. <a href="https://policies.google.com/privacy" style="color: var(--color-primary);">Google Privacy Policy</a></li>
                        </ul>
                        <div class="alert">
                            <p class="alert-text">We do not sell, trade, or transfer your workout data to any third party. The Firebase and AdMob integrations operate exclusively on anonymised or device-level data — your exercise logs and performance history never leave your device.</p>
                        </div>
                    </div>

                    <!-- Section 7: Data Storage & Security -->
                    <div class="section" id="security">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">lock</span>
                            </span>
                            <h2 class="section-title">7. Data Storage & Security</h2>
                        </div>
                        <p class="section-text">
                            The security of your data is important to us. All workout logs, exercise data, and user settings are stored exclusively on your device — either in a private SQLite database (managed by Drift) or in SharedPreferences. Neither storage location is accessible to other apps on your device.
                        </p>
                        <ul class="section-list">
                            <li><strong>No Cloud Sync:</strong> Your workout history, exercise library, and progress data are not synchronised to any cloud service. All data remains solely on your device.</li>
                            <li><strong>No Backend Servers:</strong> We do not operate backend servers that receive or process your personal workout data. The App functions as a fully local, standalone application for data storage purposes.</li>
                            <li><strong>No User Accounts:</strong> The App does not require account creation, login credentials, or authentication with any external service.</li>
                            <li><strong>Export & Import:</strong> When you export your data, a backup file is saved to your device's local storage. This file is never transmitted automatically. You control where it is saved and whether it is shared.</li>
                            <li><strong>Data Deletion:</strong> You can delete individual workout entries directly in the App. To erase all data, clear the App's storage through your device settings or uninstall the App.</li>
                        </ul>
                        <p class="section-text">
                            While we take reasonable measures to ensure that data stored locally on your device is handled responsibly, no method of electronic storage is 100% secure. Data processed by third-party services (Firebase, AdMob) is secured according to their respective security practices.
                        </p>
                    </div>

                    <!-- Section 8: Data Retention -->
                    <div class="section" id="data-retention">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">schedule</span>
                            </span>
                            <h2 class="section-title">8. Data Retention</h2>
                        </div>
                        <p class="section-text">
                            Since all workout data is stored locally on your device, data retention is entirely within your control:
                        </p>
                        <ul class="section-list">
                            <li><strong>Workout Logs & History:</strong> Retained on your device indefinitely until you delete individual entries in the App or clear the App's data.</li>
                            <li><strong>Exercise Library:</strong> Retained on your device indefinitely. Custom exercises can be deleted at any time within the App.</li>
                            <li><strong>User Settings:</strong> Retained on your device until you clear the App's data or uninstall the App.</li>
                            <li><strong>Exported Backup Files:</strong> Retained wherever you chose to save them on your device. The App does not manage or track these files after export.</li>
                            <li><strong>Third-Party Data:</strong> Data collected by Firebase Crashlytics, Firebase Analytics, and Google AdMob is retained according to their respective data retention policies.</li>
                        </ul>
                    </div>

                    <!-- Section 9: Children's Privacy -->
                    <div class="section" id="children">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">child_care</span>
                            </span>
                            <h2 class="section-title">9. Children's Privacy</h2>
                        </div>
                        <p class="section-text">
                            BuffAI is a general-purpose workout logging application and is not specifically directed at children under the age of 13 (or the applicable age of digital consent in your jurisdiction). We do not knowingly collect personally identifiable information from children. The App does not require account creation, login, or submission of any personal information.
                        </p>
                        <p class="section-text">
                            Advertisements displayed through Google AdMob comply with applicable children's advertising regulations. If you are a parent or guardian and believe your child has somehow provided personal information through the App, please contact us at the email address provided below and we will take steps to address the matter promptly.
                        </p>
                    </div>

                    <!-- Section 10: Your Rights & Choices -->
                    <div class="section" id="rights">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">gavel</span>
                            </span>
                            <h2 class="section-title">10. Your Rights & Choices</h2>
                        </div>
                        <p class="section-text">
                            You have the following choices regarding your data and privacy:
                        </p>
                        <ul class="rights-list">
                            <li><strong>Access:</strong> All workout data stored by the App is visible directly within the App. You can view your full history, exercise library, and settings at any time.</li>
                            <li><strong>Modify:</strong> You can edit any logged workout, update set or rep counts, or rename custom exercises at any time within the App.</li>
                            <li><strong>Delete:</strong> You can delete individual workout entries within the App, or erase all data by clearing the App's storage through your device settings or uninstalling the App.</li>
                            <li><strong>Export:</strong> You can export your complete workout history as a backup file at any time using the export feature. This file is saved locally to your device.</li>
                            <li><strong>Analytics opt-out:</strong> You can disable Firebase Analytics data collection via the "Analytics" toggle in the App's settings.</li>
                            <li><strong>Ad personalisation:</strong> You can opt out of personalised advertisements through your device's advertising settings, or decline the consent dialog when prompted (EEA users).</li>
                            <li><strong>Notifications:</strong> You can disable workout reminders and rest-timer alerts at any time through your device's notification settings.</li>
                            <li><strong>Permissions:</strong> You can revoke any granted permissions at any time through your device's app permission settings. Revoking certain permissions may affect specific App features.</li>
                        </ul>
                        <p class="section-text">
                            If you are located in the European Economic Area (EEA), you may have additional rights under the General Data Protection Regulation (GDPR), including the right to access, rectify, or erase data processed by third-party services. To exercise rights related to Firebase or AdMob, please contact those providers directly or reach out to us for assistance.
                        </p>
                    </div>

                    <!-- Section 11: International Users -->
                    <div class="section" id="international">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">public</span>
                            </span>
                            <h2 class="section-title">11. International Users</h2>
                        </div>
                        <p class="section-text">
                            BuffAI is available for download globally. Since we do not collect or transmit your personal workout data to our own servers, there are no cross-border data transfers of your workout history initiated by us. However, third-party services integrated into the App (such as Firebase and Google AdMob) may process device-level data in accordance with their own international data transfer practices.
                        </p>
                        <p class="section-text">
                            If you are accessing the App from outside the country where Google's servers are located, please be aware that data collected by Google's services may be transferred to, stored, and processed in countries other than your own. By using the App and consenting to third-party data collection, you acknowledge such transfers as described in Google's privacy policy.
                        </p>
                    </div>

