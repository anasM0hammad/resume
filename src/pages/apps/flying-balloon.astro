---
// privacy-policy.astro
const pageTitle = "Flying Balloon - Privacy Policy";
const lastUpdated = "March 03, 2026";
---

<html class="light scroll-smooth" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />
    
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-primary: #135bec;
            --color-background-light: #f6f6f8;
            --color-background-dark: #101622;
            --color-text-dark: #111318;
            --color-text-gray: #616f89;
            --color-text-slate: #334155;
            --color-border-light: #f0f2f4;
            --color-white: #ffffff;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--color-background-light);
            color: var(--color-text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
        }

        /* Header Styles */
        .header {
            position: sticky;
            top: 0;
            z-index: 50;
            width: 100%;
            background-color: var(--color-white);
            border-bottom: 1px solid var(--color-border-light);
            transition: all 0.2s;
        }

        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1.5rem;
            max-width: 1280px;
            margin: 0 auto;
            width: 100%;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: var(--color-text-dark);
        }

        .logo-icon {
            width: 2rem;
            height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-primary);
        }

        .logo-text {
            font-size: 1.125rem;
            font-weight: 700;
            line-height: 1.25;
            letter-spacing: -0.015em;
        }

        .nav-desktop {
            display: none;
            flex: 1;
            justify-content: flex-end;
            gap: 2rem;
            align-items: center;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2.25rem;
        }

        .nav-link {
            color: var(--color-text-dark);
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s;
        }

        .nav-link:hover {
            color: var(--color-primary);
        }

        .btn-download {
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 0.5rem;
            height: 2.5rem;
            padding: 0 1.5rem;
            background-color: var(--color-primary);
            color: white;
            font-size: 0.875rem;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: background-color 0.2s;
            box-shadow: 0 10px 15px -3px rgba(19, 91, 236, 0.2);
        }

        .btn-download:hover {
            background-color: #1d4ed8;
        }

        .mobile-menu-btn {
            display: block;
            color: var(--color-text-dark);
            background: none;
            border: none;
            cursor: pointer;
        }

        @media (min-width: 768px) {
            .nav-desktop {
                display: flex;
            }
            .mobile-menu-btn {
                display: none;
            }
        }

        @media (min-width: 1024px) {
            .header-container {
                padding: 0.75rem 2.5rem;
            }
        }

        /* Main Content */
        .main-content {
            flex-grow: 1;
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 2.5rem 1.5rem;
        }

        .content-wrapper {
            display: flex;
            flex-direction: column;
            gap: 3rem;
        }

        @media (min-width: 1024px) {
            .content-wrapper {
                flex-direction: row;
            }
            .main-content {
                padding: 2.5rem 2.5rem;
            }
        }

        /* Sidebar */
        .sidebar {
            display: none;
            width: 16rem;
            flex-shrink: 0;
        }

        @media (min-width: 1024px) {
            .sidebar {
                display: block;
            }
        }

        .sidebar-sticky {
            position: sticky;
            top: 7rem;
        }

        .sidebar-title {
            font-size: 0.875rem;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 1rem;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .sidebar-link {
            color: #475569;
            font-size: 0.875rem;
            padding: 0.5rem 1rem;
            border-left: 2px solid transparent;
            text-decoration: none;
            transition: all 0.2s;
        }

        .sidebar-link:hover {
            color: var(--color-primary);
            border-left-color: rgba(19, 91, 236, 0.3);
        }

        .sidebar-link.active {
            color: var(--color-primary);
            font-weight: 500;
            border-left-color: var(--color-primary);
        }

        /* Article Card */
        .article {
            flex: 1;
            min-width: 0;
        }

        .article-card {
            background-color: var(--color-white);
            border-radius: 0.75rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
            padding: 1.5rem;
        }

        @media (min-width: 768px) {
            .article-card {
                padding: 3rem;
            }
        }

        /* Page Header */
        .page-header {
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 2rem;
            margin-bottom: 2rem;
        }

        .header-content {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .page-title {
            color: var(--color-text-dark);
            font-size: 2.25rem;
            font-weight: 900;
            line-height: 1.2;
            letter-spacing: -0.033em;
        }

        @media (min-width: 768px) {
            .page-title {
                font-size: 3rem;
            }
        }

        .header-meta {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .badge {
            background-color: rgba(19, 91, 236, 0.1);
            color: var(--color-primary);
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .last-updated {
            color: var(--color-text-gray);
            font-size: 0.875rem;
            font-weight: 500;
        }

        /* Sections */
        .section {
            margin-bottom: 2.5rem;
            scroll-margin-top: 7rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .icon-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            border-radius: 0.25rem;
            background-color: rgba(19, 91, 236, 0.1);
            color: var(--color-primary);
        }

        .section-title {
            color: var(--color-text-dark);
            font-size: 1.5rem;
            font-weight: 700;
            line-height: 1.25;
        }

        .section-text {
            color: var(--color-text-slate);
            font-size: 1rem;
            line-height: 1.625;
            margin-bottom: 1rem;
        }

        .intro-text {
            color: var(--color-text-gray);
            font-size: 1rem;
            line-height: 1.625;
        }

        @media (min-width: 768px) {
            .intro-text {
                font-size: 1.125rem;
            }
        }

        .section-list {
            list-style-type: disc;
            padding-left: 1.25rem;
            color: var(--color-text-slate);
        }

        .section-list li {
            margin-bottom: 0.5rem;
        }

        /* Alert Box */
        .alert {
            background-color: #eff6ff;
            border-left: 4px solid var(--color-primary);
            padding: 1rem;
            border-radius: 0 0.25rem 0.25rem 0;
            margin-bottom: 1rem;
        }

        .alert-text {
            font-size: 0.875rem;
            color: #1e40af;
            font-weight: 500;
        }

        /* Permission Cards */
        .permission-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        @media (min-width: 768px) {
            .permission-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .permission-card {
            padding: 1rem;
            border-radius: 0.25rem;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
        }

        .permission-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
            font-weight: 700;
            color: var(--color-text-dark);
        }

        .permission-text {
            font-size: 0.875rem;
            color: #475569;
        }

        /* Contact Box */
        .contact-box {
            background-color: var(--color-background-light);
            padding: 1.5rem;
            border-radius: 0.5rem;
            border: 1px solid #cbd5e1;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .contact-box {
                flex-direction: row;
                align-items: center;
            }
        }

        .contact-item {
            flex: 1;
        }

        .contact-label {
            font-size: 0.875rem;
            color: #64748b;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.25rem;
        }

        .contact-link {
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--color-primary);
            text-decoration: none;
        }

        .contact-link:hover {
            text-decoration: underline;
        }

        /* Footer */
        .footer {
            background-color: var(--color-white);
            border-top: 1px solid var(--color-border-light);
            padding: 2.5rem 0;
            margin-top: auto;
        }

        .footer-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            gap: 1.5rem;
        }

        @media (min-width: 768px) {
            .footer-container {
                flex-direction: row;
            }
        }

        @media (min-width: 1024px) {
            .footer-container {
                padding: 0 2.5rem;
            }
        }

        .footer-brand {
            text-align: center;
        }

        @media (min-width: 768px) {
            .footer-brand {
                text-align: left;
            }
        }

        .footer-title {
            color: var(--color-text-dark);
            font-weight: 700;
            font-size: 1.125rem;
            margin-bottom: 0.25rem;
        }

        .footer-copyright {
            color: #64748b;
            font-size: 0.875rem;
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
        }

        .footer-link {
            color: #475569;
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-link:hover {
            color: var(--color-primary);
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="header">
        <div class="header-container">
            <div class="logo-section">
                <div class="logo-icon">
                    <span class="material-symbols-outlined" style="font-size: 1.875rem;">circle</span>
                </div>
                <h2 class="logo-text">Flying Balloon</h2>
            </div>
            <div class="nav-desktop">
                <nav class="nav-links">
                    <a class="nav-link" href="/">Home</a>
                    <a class="nav-link" href="mailto:info@mohdanas.me">Support</a>
                </nav>
                <button class="btn-download">
                    <span>Download App</span>
                </button>
            </div>
            <button class="mobile-menu-btn">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <div class="content-wrapper">
            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="sidebar-sticky">
                    <h3 class="sidebar-title">Table of Contents</h3>
                    <nav class="sidebar-nav">
                        <a class="sidebar-link active" href="#introduction">Introduction</a>
                        <a class="sidebar-link" href="#info-collect">1. Information We Collect</a>
                        <a class="sidebar-link" href="#permissions">2. Device Permissions</a>
                        <a class="sidebar-link" href="#advertising">3. Advertising</a>
                        <a class="sidebar-link" href="#third-party">4. Third-Party Services</a>
                        <a class="sidebar-link" href="#security">5. Data Storage & Security</a>
                        <a class="sidebar-link" href="#children">6. Children's Privacy</a>
                        <a class="sidebar-link" href="#rights">7. Your Rights & Choices</a>
                        <a class="sidebar-link" href="#changes">8. Changes to This Policy</a>
                        <a class="sidebar-link" href="#contact">9. Contact Us</a>
                    </nav>
                </div>
            </aside>

            <!-- Article -->
            <article class="article">
                <div class="article-card">
                    <!-- Page Header -->
                    <div class="page-header">
                        <div class="header-content">
                            <h1 class="page-title">Privacy Policy</h1>
                            <div class="header-meta">
                                <span class="badge">Legal</span>
                                <p class="last-updated">Last Updated: {lastUpdated}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Introduction -->
                    <div class="section" id="introduction">
                        <p class="intro-text">
                            Thank you for choosing <strong>Flying Balloon</strong> ("the App"), a casual arcade game developed by Gravity Lab ("we", "us", or "our"). This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our mobile application available on the Google Play Store and Apple App Store. Please read this Privacy Policy carefully. By downloading, installing, or using the App, you agree to the practices described in this policy. If you do not agree with the terms of this Privacy Policy, please do not access or use the App.
                        </p>
                    </div>

                    <!-- Section 1: Information We Collect -->
                    <div class="section" id="info-collect">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">info</span>
                            </span>
                            <h2 class="section-title">1. Information We Collect</h2>
                        </div>
                        <p class="section-text">
                            Flying Balloon is designed with a privacy-first approach. We do not require account creation or login, and we do not collect personally identifiable information such as your real name, email address, phone number, or physical address. The information associated with the App falls into the following categories:
                        </p>
                        <p class="section-text"><strong>a. Information Stored Locally on Your Device</strong></p>
                        <p class="section-text">
                            The App stores gameplay data exclusively on your device using local storage. This data never leaves your device and is not transmitted to our servers or any third party. Locally stored data includes:
                        </p>
                        <ul class="section-list">
                            <li><strong>Player Name:</strong> A self-chosen display name (up to 12 characters) used for your local leaderboard. This is not linked to any real identity.</li>
                            <li><strong>Game Progress:</strong> High scores, total games played, coins earned, daily challenge progress, and daily login streak data.</li>
                            <li><strong>Preferences:</strong> Sound and haptic feedback settings, equipped balloon skin, and onboarding completion status.</li>
                            <li><strong>Cosmetic Inventory:</strong> Owned and equipped balloon skins, earned badges, and trial skin data.</li>
                            <li><strong>Ad & Consent Data:</strong> Session count, daily ad count, and your advertising consent status (for GDPR compliance).</li>
                        </ul>
                        <div class="alert">
                            <p class="alert-text">All gameplay data is stored locally on your device. We do not operate any servers that collect or store your personal data. You can delete all stored data at any time through the Settings screen in the App.</p>
                        </div>
                        <p class="section-text"><strong>b. Information Collected by Third-Party Services</strong></p>
                        <p class="section-text">
                            The App integrates third-party services that may collect certain information automatically. This data is collected and processed by those third parties in accordance with their own privacy policies. See Section 4 (Third-Party Services) for details.
                        </p>
                    </div>

                    <!-- Section 2: Device Permissions -->
                    <div class="section" id="permissions">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">security</span>
                            </span>
                            <h2 class="section-title">2. Device Permissions</h2>
                        </div>
                        <p class="section-text">
                            The App requests the following device permissions to provide its core functionality. Each permission is used solely for the purpose described below:
                        </p>
                        <div class="permission-grid">
                            <div class="permission-card">
                                <div class="permission-header">
                                    <span class="material-symbols-outlined" style="color: var(--color-primary);">wifi</span>
                                    <span>Internet Access</span>
                                </div>
                                <p class="permission-text">Required to load and display advertisements through Google AdMob, and to send optional analytics data if enabled.</p>
                            </div>
                            <div class="permission-card">
                                <div class="permission-header">
                                    <span class="material-symbols-outlined" style="color: var(--color-primary);">signal_cellular_alt</span>
                                    <span>Network State</span>
                                </div>
                                <p class="permission-text">Used to check your network connectivity status before attempting to load advertisements or analytics.</p>
                            </div>
                            <div class="permission-card">
                                <div class="permission-header">
                                    <span class="material-symbols-outlined" style="color: var(--color-primary);">notifications</span>
                                    <span>Notifications</span>
                                </div>
                                <p class="permission-text">Used to send local reminders for daily rewards and daily challenges. No push notifications are sent from external servers. This permission is requested on Android 13+ devices.</p>
                            </div>
                            <div class="permission-card">
                                <div class="permission-header">
                                    <span class="material-symbols-outlined" style="color: var(--color-primary);">ad_units</span>
                                    <span>Advertising ID</span>
                                </div>
                                <p class="permission-text">Used by Google AdMob to serve relevant advertisements. On Android 13+ devices, this permission is explicitly requested. You may opt out of personalized ads through the consent dialog or your device settings.</p>
                            </div>
                        </div>
                        <div class="alert">
                            <p class="alert-text">The App does not access your camera, microphone, contacts, location, photos, or any other sensitive device features.</p>
                        </div>
                    </div>

                    <!-- Section 3: Advertising -->
                    <div class="section" id="advertising">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">ads_click</span>
                            </span>
                            <h2 class="section-title">3. Advertising</h2>
                        </div>
                        <p class="section-text">
                            The App is free to play and is supported by advertisements served through <strong>Google AdMob</strong>. We display the following types of ads:
                        </p>
                        <ul class="section-list">
                            <li><strong>Interstitial Ads:</strong> Full-screen ads displayed between gameplay sessions. These are shown after every third game over, capped at a maximum of five per day, and only begin appearing after your third app session.</li>
                            <li><strong>Rewarded Video Ads:</strong> Optional ads you can choose to watch in exchange for in-game benefits, such as continuing a game after a game over or doubling coins earned.</li>
                        </ul>
                        <p class="section-text">
                            The App does not display banner ads. Google AdMob may collect device information, advertising identifiers, and usage data to serve advertisements. For users in the European Economic Area (EEA), we implement Google's User Messaging Platform (UMP) to obtain your consent before serving personalized advertisements. If you decline consent, you will only receive non-personalized ads.
                        </p>
                        <p class="section-text">
                            For more information about how Google uses your data, please visit: <a href="https://policies.google.com/privacy" style="color: var(--color-primary);">Google Privacy Policy</a>.
                        </p>
                    </div>

                    <!-- Section 4: Third-Party Services -->
                    <div class="section" id="third-party">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">hub</span>
                            </span>
                            <h2 class="section-title">4. Third-Party Services</h2>
                        </div>
                        <p class="section-text">
                            The App uses the following third-party services. Each service operates under its own privacy policy, and we encourage you to review them:
                        </p>
                        <ul class="section-list">
                            <li><strong>Google AdMob:</strong> Used to display interstitial and rewarded video advertisements. AdMob may collect device identifiers, IP address, and usage data to serve and measure ads. <a href="https://policies.google.com/privacy" style="color: var(--color-primary);">Google Privacy Policy</a></li>
                            <li><strong>Firebase Analytics:</strong> Used to collect anonymous usage data such as gameplay events (game starts, game overs, ad interactions, skin purchases, badge achievements). This data helps us understand how the App is used and improve the user experience. No personally identifiable information is collected. <a href="https://firebase.google.com/support/privacy" style="color: var(--color-primary);">Firebase Privacy Information</a></li>
                            <li><strong>Firebase Crashlytics:</strong> Used to collect anonymous crash reports and error logs to help us identify and fix technical issues. Crash data may include device model, operating system version, and the state of the App at the time of the crash. <a href="https://firebase.google.com/support/privacy" style="color: var(--color-primary);">Firebase Privacy Information</a></li>
                            <li><strong>Google Play Services / App Store:</strong> Required for app distribution, in-app review prompts, and platform integration.</li>
                        </ul>
                        <div class="alert">
                            <p class="alert-text">We do not sell, trade, or otherwise transfer your information to any parties beyond the third-party services described above. No data is shared for marketing or advertising profiling purposes beyond what is required for ad delivery.</p>
                        </div>
                    </div>

                    <!-- Section 5: Data Storage & Security -->
                    <div class="section" id="security">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">lock</span>
                            </span>
                            <h2 class="section-title">5. Data Storage & Security</h2>
                        </div>
                        <p class="section-text">
                            The security of your data is important to us. All gameplay data, preferences, and progress are stored exclusively in your device's local storage (browser localStorage). This data is never transmitted to external servers operated by us.
                        </p>
                        <ul class="section-list">
                            <li><strong>No Cloud Sync:</strong> Your game progress, scores, and settings are not synchronized to any cloud service. All data remains on your device.</li>
                            <li><strong>No Backend Servers:</strong> We do not operate backend servers that receive or process your personal data.</li>
                            <li><strong>Local Leaderboard:</strong> The in-game leaderboard stores only your top five scores locally on your device. Scores are not shared with other players or uploaded to any server.</li>
                            <li><strong>Data Deletion:</strong> You can delete all locally stored data at any time by using the reset option in the App's Settings screen. Uninstalling the App will also remove all locally stored data.</li>
                        </ul>
                        <p class="section-text">
                            While we take reasonable measures to protect the data stored locally on your device, please be aware that no method of electronic storage is 100% secure. Data processed by third-party services (AdMob, Firebase) is secured according to their respective security practices.
                        </p>
                    </div>

                    <!-- Section 6: Children's Privacy -->
                    <div class="section" id="children">
                        <div class="section-header">
                            <span class="icon-wrapper">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;">child_care</span>
                            </span>
                            <h2 class="section-title">6. Children's Privacy</h2>
                        </div>
                        <p class="section-text">
