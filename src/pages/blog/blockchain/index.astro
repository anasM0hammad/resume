---
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import Layout from '../../../layouts/Layout.astro';

const blogPosts = [
  // {
  //   title: "Understanding Neural Networks: A Deep Dive into AI",
  //   description: "Explore how neural networks work, their key components, and real-world applications in modern AI systems.",
  //   date: "December 15, 2024",
  //   category: "Artificial Intelligence",
  //   readTime: "8 min read",
  //   href: "/blog/ai",
  //   tags: ["AI", "Machine Learning", "Neural Networks", "Python"]
  // },
];

const categories = [
  "All",
  "Artificial Intelligence",
  "Data Structures & Algorithms",
  "System Design",
  "Blockchain Technology",
  "Web Technologies",
  "Databases",
  "Game Development"
];
---

<Layout title="Blockchain - blogs">
  <Header />
  
  <main class="main">
    <div class="container-bg">
      <section class="blog-header">
        <h3 class="page-title">Blockchain Technology</h3>
      </section>

      <section class="search-section">
        <div class="search-container">
          <div class="search-box">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
              <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2"/>
            </svg>
            <input 
              type="text" 
              placeholder="Search articles, topics, or technologies..." 
              class="search-input"
              id="searchInput"
            />
          </div>
        </div>
      </section>

      <section class="blog-list">
        {blogPosts.length > 0 ? (
          blogPosts.map((post) => (
            <article class="blog-post-item" data-category={post.category} data-title={post.title.toLowerCase()} data-tags={post.tags.join(' ').toLowerCase()}>
              <a href={post.href} class="post-link">
                <div class="post-content">
                  <div class="post-header">
                    <h2 class="post-title">{post.title}</h2>
                    <div class="post-meta">
                      {/* <span class="post-category">{post.category}</span> */}
                      <span class="post-date">{post.date}</span>
                      <span class="post-read-time">{post.readTime}</span>
                    </div>
                  </div>
                  
                  <p class="post-description">{post.description}</p>
                  
                  <div class="post-footer">
                    <div class="post-tags">
                      {post.tags.slice(0, 4).map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                    
                    <div class="read-more-arrow">
                      <span>Read more</span>
                      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          ))
        ) : (
          <div class="no-posts-message">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <polyline points="14,2 14,8 20,8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <polyline points="10,9 9,9 8,9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h3>No posts available</h3>
            <p>There are currently no blog posts in this category. Check back later for new content!</p>
          </div>
        )}
      </section>

    </div>
  </main>
  <Footer />
</Layout>

<style>
  .main {
    margin-top: 12px;
    padding: 2rem 0 4rem;
    min-height: 95vh;
  }

  .blog-header {
    text-align: center;
    margin-top: 2rem;;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .page-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .search-section {
    margin-bottom: 3rem;
  }

  .search-container {
    max-width: 100%;
    margin: 0 auto;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    z-index: 1;
  }

  .search-input {
    width: 100%;
    padding: 1.1rem 1.2rem 1.1rem 3.0rem;
    font-size: 1.1rem;
    background: var(--bg-card);
    border: 2px solid var(--border);
    border-radius: 50px;
    color: var(--text-secondary);
    transition: all 0.2s ease;
    outline: none;
  }

  .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-light);
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .blog-post-item {
    background: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .blog-post-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--card-shadow);
    border-color: var(--accent);
  }

  .post-link {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    padding: 1.5rem 2rem;
    text-decoration: none;
    color: inherit;
  }

  .post-thumbnail {
    width: 200px;
    height: 140px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .post-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-post-item:hover .post-thumbnail img {
    transform: scale(1.05);
  }

  .post-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .post-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .post-category {
    background: #4D57DE;
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .post-description {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    /* margin-bottom: 1.5rem; */
  }

  .post-footer {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 2rem;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: var(--tag-bg);
    color: var(--accent);
    padding: 0.25rem 0.75rem;
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .read-more-arrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
    margin-left: auto;
  }

  .blog-post-item:hover .read-more-arrow {
    transform: translateX(4px);
  }

  .blog-post-item.hidden {
    display: none;
  }

  .no-posts-message {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-secondary);
  }

  .no-posts-message svg {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .no-posts-message h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .no-posts-message p {
    font-size: 1rem;
    line-height: 1.6;
    max-width: 400px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .page-description {
      font-size: 1rem;
    }

    .search-input {
      padding: 1rem 1rem 1rem 3rem;
      font-size: 1rem;
    }

    .search-icon {
      left: 1rem;
    }

    .post-title{
      font-size: 1.2rem;
    }

    .post-header{
      display: block;
      margin-bottom: 1rem;
    }

    .post-link {
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
    }

    .post-thumbnail {
      width: 100%;
      height: 200px;
    }

    .post-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .read-more-arrow {
     display: none;
    }
    
    .post-tags{
      display: none;
    }
  }
</style>