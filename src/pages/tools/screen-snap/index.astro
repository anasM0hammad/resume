---
const title = "ScreenSnap — Free Screenshot Resizer for App & Play Store";
const description = "Free online tool to resize screenshots to pixel-perfect dimensions for App Store and Play Store. Batch resize, preview, and download as ZIP. No signup required.";
const url = "https://mohdanas.me/tools/screen-snap";
const ogImage = "https://mohdanas.me/og-screensnap.jpg";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={url} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

  <!-- Keywords (supplementary signal) -->
  <meta name="keywords" content="app store screenshot generator, app store screenshot sizes, google play screenshot sizes, ios screenshot resizer, app store screenshot tool, screenshot resize tool, apple app store screenshots, play store screenshots, app screenshot dimensions, batch screenshot resizer, free screenshot generator, screensnap" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="ScreenSnap by Mohammad Anas" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:creator" content="@user_anas_" />

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="/og-screensnap.jpg">
  <link rel="apple-touch-icon" href="/og-screensnap.jpg" />

  <!-- Structured Data: WebApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ScreenSnap",
    "url": url,
    "description": description,
    "applicationCategory": "DesignApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "author": {
      "@type": "Person",
      "name": "Mohammad Anas",
      "url": "https://mohdanas.me"
    },
    "browserRequirements": "Requires a modern browser with JavaScript enabled",
    "featureList": [
      "Apple App Store screenshot resizing (iPhone & iPad)",
      "Google Play Store screenshot resizing (Phone & Tablet)",
      "Batch resize to all required dimensions",
      "Live preview with per-slot management",
      "ZIP download with organized folder structure",
      "Fill (crop) and Fit (letterbox) resize modes",
      "No signup or account required"
    ]
  })} />

  <!-- Structured Data: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What are the required screenshot sizes for the Apple App Store?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Apple requires screenshots for iPhone 6.9\" (1320×2868), iPhone 6.7\" (1290×2796), iPhone 6.5\" (1284×2778), iPhone 6.1\" (1179×2556), iPhone 5.5\" (1242×2208), iPad 13\" (2064×2752), iPad 12.9\" (2048×2732), and iPad 11\" (1668×2388). As of 2025, only the 6.9\" iPhone and 13\" iPad sets are mandatory — smaller sizes auto-scale."
        }
      },
      {
        "@type": "Question",
        "name": "What are the required screenshot sizes for Google Play Store?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Google Play requires Phone screenshots at 1080×1920, 7-inch Tablet at 1200×1920, and 10-inch Tablet at 1920×2560. Minimum 2 screenshots per listing, maximum 8. Images must be JPEG or 24-bit PNG, max 8 MB each."
        }
      },
      {
        "@type": "Question",
        "name": "Is ScreenSnap free to use?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, ScreenSnap is completely free with no signup required. All processing happens in your browser — your images are never uploaded to any server."
        }
      }
    ]
  })} />

  <!-- Structured Data: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mohdanas.me" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://mohdanas.me/tools" },
      { "@type": "ListItem", "position": 3, "name": "ScreenSnap", "item": url }
    ]
  })} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- JSZip -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <!-- Theme (prevents flash) -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('screensnap-theme');
      const theme = saved || 'dark';
      document.documentElement.setAttribute('data-tool-theme', theme);
    })();
  </script>
</head>
<body>

<!-- Toolbar -->
<nav class="toolbar">
  <div class="toolbar-left">
    <a href="/" class="toolbar-back" title="Back to portfolio">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
    <div class="toolbar-brand">
      <img class="brand-logo" src="/og-screensnap.jpg" alt="ScreenSnap" width="28" height="28" />
      <span class="brand-name">ScreenSnap</span>
    </div>
  </div>
  <div class="toolbar-right">
    <button class="btn-secondary btn-toolbar-add" id="toolbar-add-device" style="display:none">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
      Add Device
    </button>
    <button class="btn-icon" id="theme-toggle" title="Toggle theme">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </div>
</nav>

<!-- Main Content -->
<main class="main">
  <!-- Hero -->
  <section class="hero">
    <h1>Screenshot Resizer</h1>
    <p class="hero-sub">Resize screenshots to exact App Store & Play Store dimensions. Download as ZIP.</p>
  </section>

  <!-- Controls Bar -->
  <section class="controls">
    <div class="control-group">
      <div class="preset-chips">
        <button class="chip" data-preset="essential-ios">Essential iOS</button>
        <button class="chip" data-preset="full-ios">Full iOS</button>
        <button class="chip" data-preset="essential-android">Essential Android</button>
        <button class="chip" data-preset="full-android">Full Android</button>
        <button class="chip" data-preset="both-essential">Both (Essential)</button>
        <button class="chip" data-preset="all">Everything</button>
      </div>
    </div>
    <div class="control-group">
      <div class="toggle-group">
        <button class="toggle-btn active" data-mode="fill">Fill (Crop)</button>
        <button class="toggle-btn" data-mode="fit">Fit (Letterbox)</button>
      </div>
    </div>
  </section>

  <!-- Device Rows Container -->
  <section class="device-rows" id="device-rows">
    <!-- Rows are dynamically generated -->
    <div class="empty-state" id="empty-state">
      <div class="empty-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M12 9v6"/><path d="M9 12h6"/></svg>
      </div>
      <p>Select a preset above or manually add device types below</p>
      <button class="btn-primary" id="add-device-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        Add Device Type
      </button>
    </div>
  </section>

  <!-- Add Device Modal -->
  <div class="modal-overlay" id="device-modal">
    <div class="modal">
      <div class="modal-header">
        <h3>Add Device Type</h3>
        <button class="btn-icon modal-close" id="modal-close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <!-- Apple Section -->
        <div class="store-section">
          <div class="store-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            <span>Apple App Store</span>
          </div>
          <div class="device-options">
            <label class="device-option" data-store="apple" data-device="iphone-6.9">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">iPhone 6.9"</span>
                <span class="option-dim">1320 × 2868</span>
              </div>
              <button class="copy-dim" data-dim="1320x2868" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="apple" data-device="iphone-6.7">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">iPhone 6.7"</span>
                <span class="option-dim">1290 × 2796</span>
              </div>
              <button class="copy-dim" data-dim="1290x2796" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="apple" data-device="iphone-6.5">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">iPhone 6.5"</span>
                <span class="option-dim">1284 × 2778</span>
              </div>
              <button class="copy-dim" data-dim="1284x2778" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="apple" data-device="iphone-6.1">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">iPhone 6.1"</span>
                <span class="option-dim">1179 × 2556</span>
              </div>
              <button class="copy-dim" data-dim="1179x2556" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="apple" data-device="iphone-5.5">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">iPhone 5.5"</span>
                <span class="option-dim">1242 × 2208</span>
              </div>
              <button class="copy-dim" data-dim="1242x2208" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="apple" data-device="ipad-13">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">iPad 13"</span>
                <span class="option-dim">2064 × 2752</span>
              </div>
              <button class="copy-dim" data-dim="2064x2752" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="apple" data-device="ipad-12.9">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">iPad 12.9"</span>
                <span class="option-dim">2048 × 2732</span>
              </div>
              <button class="copy-dim" data-dim="2048x2732" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="apple" data-device="ipad-11">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">iPad 11"</span>
                <span class="option-dim">1668 × 2388</span>
              </div>
              <button class="copy-dim" data-dim="1668x2388" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
          </div>
        </div>

        <!-- Google Section -->
        <div class="store-section">
          <div class="store-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 2.04c-.24.4-.18.92-.18 1.38v17.17c0 .46-.06.98.18 1.38l.08.07 9.6-9.6v-.22L3.26 2.62l-.08-.08z" fill="#4285F4"/><path d="M16.07 15.63l-3.2-3.2v-.22l3.2-3.2.07.04 3.79 2.15c1.08.61 1.08 1.62 0 2.24l-3.79 2.15-.07.04z" fill="#FBBC04"/><path d="M16.14 15.59L12.86 12.3 3.18 21.97c.36.38.94.41 1.6.04l11.36-6.42z" fill="#EA4335"/><path d="M16.14 8.97L4.78 2.55c-.66-.37-1.24-.34-1.6.04l9.68 9.68 3.28-3.3z" fill="#34A853"/></svg>
            <span>Google Play Store</span>
          </div>
          <div class="device-options">
            <label class="device-option" data-store="google" data-device="phone">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">Phone</span>
                <span class="option-dim">1080 × 1920</span>
              </div>
              <button class="copy-dim" data-dim="1080x1920" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="google" data-device="tablet-7">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">7" Tablet</span>
                <span class="option-dim">1200 × 1920</span>
              </div>
              <button class="copy-dim" data-dim="1200x1920" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
            <label class="device-option" data-store="google" data-device="tablet-10">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">10" Tablet</span>
                <span class="option-dim">1920 × 2560</span>
              </div>
              <button class="copy-dim" data-dim="1920x2560" title="Copy dimensions">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              </button>
            </label>
          </div>
        </div>

        <!-- Chrome Extension Section -->
        <div class="store-section">
          <div class="store-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.45 7.09l.002.001-3.953 6.848c.539.073 1.088.111 1.646.111 6.075 0 11.027-4.509 11.852-10.352h-7.906zM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"/></svg>
            <span>Chrome Extension</span>
          </div>
          <div class="device-options">
            <label class="device-option" data-store="chrome" data-device="icons">
              <input type="checkbox" />
              <div class="option-info">
                <span class="option-name">Extension Icons</span>
                <span class="option-dim">16, 32, 48, 128</span>
              </div>
            </label>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="modal-cancel">Cancel</button>
        <button class="btn-primary" id="modal-add">Add Selected</button>
      </div>
    </div>
  </div>

  <!-- Floating Add Button (shows when rows exist) -->
  <button class="fab" id="fab-add" style="display:none" title="Add device type">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
  </button>

  <!-- Download Bar -->
  <section class="download-bar" id="download-bar" style="display:none">
    <div class="download-info">
      <span id="download-summary">0 screenshots ready</span>
    </div>
    <button class="btn-primary btn-download" id="download-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download ZIP
    </button>
  </section>

  <!-- Dimensions Quick Reference -->
  <section class="ref-card">
    <details>
      <summary class="ref-toggle">
        Quick Reference — All Required Dimensions
        <svg class="ref-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="ref-content">
        <div class="ref-store">
          <h4>Apple App Store</h4>
          <div class="ref-grid">
            <div class="ref-item"><span>iPhone 6.9"</span><code>1320 × 2868</code></div>
            <div class="ref-item"><span>iPhone 6.7"</span><code>1290 × 2796</code></div>
            <div class="ref-item"><span>iPhone 6.5"</span><code>1284 × 2778</code></div>
            <div class="ref-item"><span>iPhone 6.1"</span><code>1179 × 2556</code></div>
            <div class="ref-item"><span>iPhone 5.5"</span><code>1242 × 2208</code></div>
            <div class="ref-item"><span>iPad 13"</span><code>2064 × 2752</code></div>
            <div class="ref-item"><span>iPad 12.9"</span><code>2048 × 2732</code></div>
            <div class="ref-item"><span>iPad 11"</span><code>1668 × 2388</code></div>
          </div>
        </div>
        <div class="ref-store">
          <h4>Google Play Store</h4>
          <div class="ref-grid">
