    border: 1px solid var(--ss-border);
    border-radius: var(--ss-radius);
    line-height: 1.8;
  }
  .seo-content h2 { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; }
  .seo-content h3 { font-size: 1rem; font-weight: 600; margin-top: 1.25rem; margin-bottom: 0.5rem; }
  .seo-content p { font-size: 0.88rem; color: var(--ss-text-secondary); margin-bottom: 0.75rem; }
  .seo-content ol { padding-left: 1.25rem; margin-bottom: 0.75rem; }
  .seo-content li { font-size: 0.88rem; color: var(--ss-text-secondary); margin-bottom: 0.375rem; }
  .seo-content strong { color: var(--ss-text); }

  /* ===== Footer ===== */
  .tool-footer {
    text-align: center;
    padding: 1.5rem 0 0;
    margin-top: 2rem;
    border-top: 1px solid var(--ss-border-light);
  }
  .tool-footer p { font-size: 0.8rem; color: var(--ss-text-muted); }
  .tool-footer a { color: var(--ss-accent); text-decoration: none; }
  .tool-footer a:hover { text-decoration: underline; }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .main { padding: 1.25rem 1rem 6rem; }
    .hero h1 { font-size: 1.35rem; }
    .hero { margin-bottom: 1rem; }
    .hero-sub { white-space: normal; font-size: 0.85rem; }
    .controls { flex-direction: column; align-items: stretch; gap: 0.75rem; padding: 0.75rem; }
    .control-group { flex-wrap: wrap; }
    .preset-chips { flex-wrap: wrap; }
    .ref-content { grid-template-columns: 1fr; }
    .fab { bottom: 4.5rem; right: 1rem; }
    .row-header { flex-wrap: wrap; gap: 0.5rem; }
    .row-header-left { gap: 0.5rem; }
    .row-dimensions { font-size: 0.68rem; }
    .seo-content { padding: 1.25rem; }
    .btn-toolbar-add { display: none !important; }
  }

  @media (max-width: 480px) {
    .toolbar { padding: 0 1rem; }
    .hero h1 { font-size: 1.15rem; }
    .hero-sub { font-size: 0.8rem; }
    .chip { font-size: 0.72rem; padding: 0.3rem 0.6rem; min-height: 34px; display: inline-flex; align-items: center; }
    .brand-name { font-size: 0.95rem; }
  }
</style>

<script>
  // ===== DEVICE SPECS =====
  const DEVICE_SPECS = {
    // Apple
    'apple|iphone-6.9': { store: 'Apple App Store', name: 'iPhone 6.9"', w: 1320, h: 2868, maxSlots: 10 },
    'apple|iphone-6.7': { store: 'Apple App Store', name: 'iPhone 6.7"', w: 1290, h: 2796, maxSlots: 10 },
    'apple|iphone-6.5': { store: 'Apple App Store', name: 'iPhone 6.5"', w: 1284, h: 2778, maxSlots: 10 },
    'apple|iphone-6.1': { store: 'Apple App Store', name: 'iPhone 6.1"', w: 1179, h: 2556, maxSlots: 10 },
    'apple|iphone-5.5': { store: 'Apple App Store', name: 'iPhone 5.5"', w: 1242, h: 2208, maxSlots: 10 },
    'apple|ipad-13':    { store: 'Apple App Store', name: 'iPad 13"',    w: 2064, h: 2752, maxSlots: 10 },
    'apple|ipad-12.9':  { store: 'Apple App Store', name: 'iPad 12.9"',  w: 2048, h: 2732, maxSlots: 10 },
    'apple|ipad-11':    { store: 'Apple App Store', name: 'iPad 11"',    w: 1668, h: 2388, maxSlots: 10 },
    // Google
    'google|phone':      { store: 'Google Play Store', name: 'Phone',       w: 1080, h: 1920, maxSlots: 8 },
    'google|tablet-7':   { store: 'Google Play Store', name: '7" Tablet',   w: 1200, h: 1920, maxSlots: 8 },
    'google|tablet-10':  { store: 'Google Play Store', name: '10" Tablet',  w: 1920, h: 2560, maxSlots: 8 },
    // Chrome Extension
    'chrome|icons':      { store: 'Chrome Extension',  name: 'Extension Icons', w: 128, h: 128, maxSlots: 1, sizes: [16, 32, 48, 128] },
  };

  const PRESETS = {
    'essential-ios':     ['apple|iphone-6.9', 'apple|ipad-13'],
    'full-ios':          ['apple|iphone-6.9', 'apple|iphone-6.7', 'apple|iphone-6.5', 'apple|iphone-6.1', 'apple|iphone-5.5', 'apple|ipad-13', 'apple|ipad-12.9', 'apple|ipad-11'],
    'essential-android': ['google|phone'],
    'full-android':      ['google|phone', 'google|tablet-7', 'google|tablet-10'],
    'both-essential':    ['apple|iphone-6.9', 'apple|ipad-13', 'google|phone'],
    'all':               Object.keys(DEVICE_SPECS),
  };

  // ===== STATE =====
  let activeRows: { key: any; images: any[]; }[] = []; // { key, images: [{ file, dataUrl }|null, ...] }
  let resizeMode = 'fill';

  // ===== DOM =====
  const rowsContainer = document.getElementById('device-rows');
  const emptyState = document.getElementById('empty-state');
  const addDeviceBtn = document.getElementById('add-device-btn');
  const fabAdd = document.getElementById('fab-add');
  const modal = document.getElementById('device-modal');
  const modalClose = document.getElementById('modal-close');
  const modalCancel = document.getElementById('modal-cancel');
  const modalAdd = document.getElementById('modal-add');
  const downloadBar = document.getElementById('download-bar');
  const downloadSummary = document.getElementById('download-summary');
  const downloadBtn = document.getElementById('download-btn');
  const toolbarAddDevice = document.getElementById('toolbar-add-device');
  const toastEl = document.getElementById('toast');

  // ===== THEME =====
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const current = html.getAttribute('data-tool-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-tool-theme', next);
    localStorage.setItem('screensnap-theme', next);
  });

  // ===== TOAST =====
  let toastTimeout: string | number | NodeJS.Timeout | undefined;
  function showToast(msg: string | null) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => toastEl.classList.remove('show'), 2000);
  }

  // ===== COPY DIMENSIONS =====
  document.querySelectorAll('.copy-dim').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const dim = btn.getAttribute('data-dim');
      const [w, h] = dim.split('x');
      navigator.clipboard.writeText(`${w} × ${h}`).then(() => showToast(`Copied: ${w} × ${h}`));
    });
  });

  document.querySelectorAll('.ref-item code').forEach(code => {
    code.addEventListener('click', () => {
      navigator.clipboard.writeText(code.textContent).then(() => showToast(`Copied: ${code.textContent}`));
    });
  });

  // ===== MODAL =====
  function openModal() {
    // Uncheck all, then check already-active ones
    modal.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
    activeRows.forEach(r => {
      const parts = r.key.split('|');
      const option = modal.querySelector(`.device-option[data-store="${parts[0]}"][data-device="${parts[1]}"]`);
      if (option) {
        option.querySelector('input').checked = true;
        option.querySelector('input').disabled = true;
        option.style.opacity = '0.5';
      }
    });
    modal.classList.add('open');
  }

  function closeModal() {
    modal.classList.remove('open');
    // Reset disabled state
    modal.querySelectorAll('.device-option').forEach(opt => {
      opt.querySelector('input').disabled = false;
      opt.style.opacity = '';
    });
  }

  addDeviceBtn?.addEventListener('click', openModal);
  fabAdd?.addEventListener('click', openModal);
  toolbarAddDevice?.addEventListener('click', openModal);
  modalClose?.addEventListener('click', closeModal);
  modalCancel?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  modalAdd?.addEventListener('click', () => {
    const checkedOptions = modal.querySelectorAll('.device-option input:checked:not(:disabled)');
    checkedOptions.forEach(cb => {
      const option = cb.closest('.device-option');
      const store = option.getAttribute('data-store');
      const device = option.getAttribute('data-device');
      const key = `${store}|${device}`;
      if (!activeRows.find(r => r.key === key)) {
        const spec = DEVICE_SPECS[key];
        activeRows.push({ key, images: new Array(spec.maxSlots).fill(null) });
      }
    });
    closeModal();
    renderRows();
  });

  // ===== PRESETS =====
  document.querySelectorAll('.chip[data-preset]').forEach(chip => {
    chip.addEventListener('click', () => {
      const presetKey = chip.getAttribute('data-preset');
      const devices = PRESETS[presetKey];
      if (!devices) return;

      // Toggle active state for chip UI
      document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      // Add devices not already present
      devices.forEach((key: string | number) => {
        if (!activeRows.find(r => r.key === key)) {
          const spec = DEVICE_SPECS[key];
          activeRows.push({ key, images: new Array(spec.maxSlots).fill(null) });
        }
      });
      renderRows();
    });
  });

  // ===== RESIZE MODE =====
  document.querySelectorAll('.toggle-btn[data-mode]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.toggle-btn[data-mode]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      resizeMode = btn.getAttribute('data-mode');
    });
  });

  // ===== RENDER ROWS =====
  function renderRows() {
    // Remove old rows
    rowsContainer.querySelectorAll('.device-row').forEach(el => el.remove());

    if (activeRows.length === 0) {
      emptyState.style.display = 'flex';
      fabAdd.style.display = 'none';
      toolbarAddDevice.style.display = 'none';
      downloadBar.style.display = 'none';
      return;
    }

    emptyState.style.display = 'none';
    fabAdd.style.display = 'flex';
    toolbarAddDevice.style.display = 'inline-flex';

    activeRows.forEach((row, rowIdx) => {
      const spec = DEVICE_SPECS[row.key];
      const storeClass = row.key.startsWith('apple') ? 'apple' : row.key.startsWith('google') ? 'google' : 'chrome';
      const badgeLabel = storeClass === 'apple' ? 'iOS' : storeClass === 'google' ? 'Android' : 'Chrome';
      const dimLabel = spec.sizes ? spec.sizes.map(s => s + 'px').join(', ') : `${spec.w} × ${spec.h}`;

      const rowEl = document.createElement('div');
      rowEl.className = 'device-row store-' + storeClass;
      rowEl.setAttribute('data-row-key', row.key);

      // Header
      rowEl.innerHTML = `
        <div class="row-header">
          <div class="row-header-left">
            <span class="store-badge ${storeClass}">${badgeLabel}</span>
            <span class="row-device-name">${spec.name}</span>
            <span class="row-dimensions">${dimLabel}</span>
          </div>
          <div class="row-header-right">
            <button class="btn-sm copy-row-dim" title="Copy dimensions" data-dim="${dimLabel}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            </button>
            <button class="btn-sm danger remove-row" title="Remove device type">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
        <div class="row-body">
          <div class="slots-row"></div>
        </div>
      `;

      const slotsRow = rowEl.querySelector('.slots-row');

      // Render image slots
      row.images.forEach((img: any, slotIdx: any) => {
        const slot = createSlot(rowIdx, slotIdx, img);
        slotsRow.appendChild(slot);
      });

      // Event: copy dims
      rowEl.querySelector('.copy-row-dim').addEventListener('click', () => {
        const dim = `${spec.w} × ${spec.h}`;
        navigator.clipboard.writeText(dim).then(() => showToast(`Copied: ${dim}`));
      });

      // Event: remove row
      rowEl.querySelector('.remove-row').addEventListener('click', () => {
        activeRows.splice(rowIdx, 1);
        renderRows();
      });

      rowsContainer.appendChild(rowEl);
    });

    updateDownloadBar();
  }

  function createSlot(rowIdx, slotIdx, imgData) {
    const row = activeRows[rowIdx];
    const spec = DEVICE_SPECS[row.key];
    const slotH = 400;
    const slotW = Math.round(slotH * (spec.w / spec.h));

    const slot = document.createElement('div');
    slot.className = 'slot' + (imgData ? ' has-image' : '');
    slot.style.width = slotW + 'px';
    slot.style.height = slotH + 'px';

    const preview = document.createElement('img');
    preview.className = 'slot-preview';
    if (imgData) preview.src = imgData.dataUrl;

    const placeholder = document.createElement('div');
    placeholder.className = 'slot-placeholder';
    placeholder.innerHTML = `
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
      <span>#${slotIdx + 1}</span>
    `;

    const removeBtn = document.createElement('button');
    removeBtn.className = 'slot-remove';
    removeBtn.innerHTML = '×';
    removeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      activeRows[rowIdx].images[slotIdx] = null;
      renderRows();
    });

    const number = document.createElement('span');
    number.className = 'slot-number';
    number.textContent = `#${slotIdx + 1}`;

    slot.appendChild(preview);
    slot.appendChild(placeholder);
    slot.appendChild(removeBtn);
    slot.appendChild(number);

    // Click to upload on empty slot
    if (!imgData) {
      slot.addEventListener('click', () => {
        triggerFileUpload(rowIdx, slotIdx);
      });
    } else {
      // Click filled slot to replace
      preview.addEventListener('click', () => {
        triggerFileUpload(rowIdx, slotIdx);
      });
      preview.style.cursor = 'pointer';
    }

    // Drag and drop
    slot.addEventListener('dragover', (e) => {
      e.preventDefault();
      slot.style.borderColor = 'var(--ss-accent)';
      slot.style.background = 'var(--ss-accent-light)';
    });
    slot.addEventListener('dragleave', () => {
      slot.style.borderColor = '';
      slot.style.background = '';
    });
    slot.addEventListener('drop', (e) => {
      e.preventDefault();
      slot.style.borderColor = '';
      slot.style.background = '';
      const files = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/'));
      if (files.length > 0) {
        handleFilesForRow(rowIdx, slotIdx, files);
      }
    });

    return slot;
  }

  // ===== FILE HANDLING =====
  function triggerFileUpload(rowIdx, slotIdx) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.multiple = true;
    input.addEventListener('change', () => {
      const files = Array.from(input.files);
      if (files.length > 0) {
        handleFilesForRow(rowIdx, slotIdx, files);
      }
    });
    input.click();
  }

  function handleFilesForRow(rowIdx, startSlot, files) {
    const row = activeRows[rowIdx];
    if (!row) return;

    const maxSlots = row.images.length;
    let loaded = 0;
    const total = Math.min(files.length, maxSlots - startSlot);

    files.slice(0, total).forEach((file, i) => {
      // First file goes to the clicked slot, rest fill forward
      const targetSlot = startSlot + i;
      if (targetSlot >= maxSlots) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        row.images[targetSlot] = { file, dataUrl: e.target.result };
        loaded++;
        if (loaded === total) {
          renderRows();
        }
      };
      reader.readAsDataURL(file);
    });
  }

  // ===== DOWNLOAD =====
  function updateDownloadBar() {
    let total = 0;
    activeRows.forEach(r => r.images.forEach((img: any) => { if (img) total++; }));
    if (total > 0) {
      downloadBar.style.display = 'flex';
      downloadSummary.textContent = `${total} screenshot${total !== 1 ? 's' : ''} across ${activeRows.length} device type${activeRows.length !== 1 ? 's' : ''} — ready to export`;
    } else if (activeRows.length > 0) {
      downloadBar.style.display = 'flex';
      downloadSummary.textContent = `${activeRows.length} device type${activeRows.length !== 1 ? 's' : ''} selected — add screenshots to export`;
      downloadBtn.disabled = true;
    } else {
      downloadBar.style.display = 'none';
    }
    if (total > 0) downloadBtn.disabled = false;
  }

  downloadBtn?.addEventListener('click', async () => {
    downloadBtn.disabled = true;
    downloadBtn.innerHTML = `<svg class="spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4m0 12v4m10-10h-4M6 12H2m15.07-7.07l-2.83 2.83M9.76 14.24l-2.83 2.83m12.14 0l-2.83-2.83M9.76 9.76L6.93 6.93"/></svg> Generating...`;

    try {
      const zip = new JSZip();
      const promises: any[] = [];

      activeRows.forEach((row) => {
        const spec = DEVICE_SPECS[row.key];

        if (spec.sizes) {
          // Chrome Extension icons — resize single image to multiple sizes
          const folderPath = 'Chrome Extension';
          const img = row.images[0];
          if (!img) return;

          spec.sizes.forEach((size) => {
            const promise = resizeImage(img.dataUrl, size, size, 'fill').then(blob => {
              zip.file(`${folderPath}/icon_${size}x${size}.png`, blob);
            });
            promises.push(promise);
          });
        } else {
          // Normal device — one resize per image
          const storeFolder = row.key.startsWith('apple') ? 'Apple App Store' : 'Google Play Store';
          const deviceFolder = spec.name.replace(/"/g, 'in');
          const folderPath = `${storeFolder}/${deviceFolder}`;

          row.images.forEach((img: { dataUrl: any; }, idx: number) => {
            if (!img) return;

            const promise = resizeImage(img.dataUrl, spec.w, spec.h, resizeMode).then(blob => {
              const filename = `screenshot_${(idx + 1).toString().padStart(2, '0')}.png`;
              zip.file(`${folderPath}/${filename}`, blob);
            });
            promises.push(promise);
          });
        }
      });

      await Promise.all(promises);
      const content = await zip.generateAsync({ type: 'blob' });

      const link = document.createElement('a');
      link.href = URL.createObjectURL(content);
      link.download = 'screenshots.zip';
      link.click();
      URL.revokeObjectURL(link.href);
      showToast('ZIP downloaded successfully!');
    } catch (err) {
      console.error(err);
      showToast('Error generating ZIP');
    }

    downloadBtn.disabled = false;
    downloadBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Download ZIP`;
  });

  // ===== IMAGE RESIZE =====
  function resizeImage(dataUrl: string, targetW: number, targetH: number, mode: string) {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d');

        if (mode === 'fill') {
          // Cover: scale to fill, crop overflow
          const scale = Math.max(targetW / img.width, targetH / img.height);
          const sw = targetW / scale;
          const sh = targetH / scale;
          const sx = (img.width - sw) / 2;
          const sy = (img.height - sh) / 2;
          ctx.drawImage(img, sx, sy, sw, sh, 0, 0, targetW, targetH);
        } else {
          // Fit: scale to contain, letterbox with dark bg
          ctx.fillStyle = '#000000';
          ctx.fillRect(0, 0, targetW, targetH);
          const scale = Math.min(targetW / img.width, targetH / img.height);
          const dw = img.width * scale;
          const dh = img.height * scale;
          const dx = (targetW - dw) / 2;
          const dy = (targetH - dh) / 2;
          ctx.drawImage(img, 0, 0, img.width, img.height, dx, dy, dw, dh);
        }

        canvas.toBlob(resolve, 'image/png');
      };
      img.src = dataUrl;
    });
  }

  // ===== SPINNING ANIMATION =====
  const style = document.createElement('style');
  style.textContent = `@keyframes spin { to { transform: rotate(360deg); } } .spin { animation: spin 1s linear infinite; }`;
  document.head.appendChild(style);

  // ===== INITIAL RENDER =====
  renderRows();
</script>

</body>
</html>
