<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=JetBrains+Mono:wght@400;500;600;700&family=Lobster&family=Righteous&display=swap" rel="stylesheet">
		<!-- Bootstrap CSS -->
		<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

		<!-- FONT AWESOME -->
		<script src="https://kit.fontawesome.com/34aa8a70b7.js"></script>

		<!-- LOGO -->
		<link rel="icon" type="image/gif" href="/logo.png">
		<meta name="generator" content={Astro.generator} />
		<title>{Astro.props.title || "Anas"}</title>
		<meta name="description" content="The Portfolio website of Mohammad Anas">
		<!-- Open Graph Tags -->
		<meta property="og:title" content={Astro.props.ogTitle || ""}>
		<meta property="og:description" content={Astro.props.ogDescription || "Tech blog by Mohammad Anas"}>
		<meta property="og:image" content={`https://mohdanas.me${Astro.props.ogImage}` || ""}>
		<meta property="og:url" content="https://mohdanas.me">
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="Mohammad Anas blogs">
		<!-- End Open Graph Tags -->

		<!-- Theme initialization (prevents flash) -->
		<script is:inline>
			(function() {
				const saved = localStorage.getItem('theme');
				const theme = saved || 'dark';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-N44GY1H0PG"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', 'G-N44GY1H0PG');
	</script>
	<body>
		<slot />
		 <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>

    <script>
		import Typewriter from 'typewriter-effect/dist/core';
        var app = document.getElementById('typewritter-text');

		if (app) {
			var typewriter = new Typewriter(app, {
			loop: true,
			delay: 75,
			});

			typewriter
			.pauseFor(400)
			.typeString('<strong style="color: var(--accent)">Software Engineer</strong>')
			.pauseFor(400)
			.deleteChars(17)
			.typeString('<strong style="color: var(--accent)">Fullstack Developer</strong>')
			.pauseFor(400)
			.deleteChars(19)
			.typeString('<strong style="color: var(--accent)">Blockchain Developer</strong>')
			.pauseFor(400)
			.deleteChars(20)
			.typeString('<strong style="color: var(--accent)">Beginner Guitarist</strong>')
			.pauseFor(400)
			.deleteChars(18)
			.pauseFor(1000)
			.start();
		}
    </script>

	</body>
</html>

<style is:global>
	@import '../styles/global.css';

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
