---
import { Image } from 'astro:assets';
import adobe from './../assets/adobe.png';
import samsung from './../assets/samsung.png';
import emvoke from './../assets/emvoke.webp';
import internshala from './../assets/internshala.jpg';
import infinocto from './../assets/infi.png';

interface Role {
  title: string;
  period: string;
  highlights: string[];
  tech: string[];
}

interface Company {
  name: string;
  location: string;
  logo: any;
  logoClass?: string;
  period: string;
  website?: string;
  roles: Role[];
}

const companies: Company[] = [
  {
    name: "Adobe",
    location: "Noida",
    logo: adobe,
    period: "May 2021 - Present",
    website: "https://www.adobe.com/in/",
    roles: [
      {
        title: "Computer Scientist",
        period: "Feb 2025 - Present",
        highlights: [
          "Composite Native PDFs for Photoshop with real-time collaboration",
          "Leading DCX library — 60% payload reduction"
        ],
        tech: ["JS", "TS", "C++", "Java", "Node", "React"]
      },
      {
        title: "SDE 2",
        period: "Aug 2022 - Jan 2025",
        highlights: [
          "CoreSync migration to ID-based sync — 45% latency reduction",
          "USS search service with ElasticSearch — 50%+ cost reduction",
          "PUPA service for user-to-asset event indexing"
        ],
        tech: ["JS", "TS", "C++", "Java", "Node"]
      },
      {
        title: "SDE",
        period: "May 2021 - Jul 2022",
        highlights: [
          "Built log analyzer tool with Electron + React",
          "ACPL CoreSync — Adobe's core cloud sync engine"
        ],
        tech: ["C++", "React", "Python"]
      }
    ]
  },
  {
    name: "Samsung",
    location: "Noida",
    logo: samsung,
    logoClass: "logo-wide",
    period: "Feb 2021 - May 2021",
    website: "https://research.samsung.com/sri-n",
    roles: [
      {
        title: "Software Engineer",
        period: "Feb 2021 - May 2021",
        highlights: [
          "Android system layer — Memory Management team",
          "Fixed critical SD card ejection flow bugs"
        ],
        tech: ["C++", "Android"]
      }
    ]
  },
  {
    name: "Emvoke",
    location: "Remote",
    logo: emvoke,
    logoClass: "logo-wide",
    period: "Dec 2019 - Feb 2021",
    website: "https://www.emvoke.com/",
    roles: [
      {
        title: "Software Development Engineer",
        period: "Jun 2020 - Jan 2021",
        highlights: [
          "Full-stack clinic management SaaS with Angular",
          "Medical data integration with SnomedCT & LOINC",
          "Mentored 4 interns on Angular best practices"
        ],
        tech: ["Angular", "Python", "TS", "Node"]
      },
      {
        title: "Software Engineer Intern",
        period: "Dec 2019 - May 2020",
        highlights: [
          "Auth & RBAC implementation for the platform"
        ],
        tech: ["Angular", "TS", "JS"]
      }
    ]
  },
  {
    name: "Internshala",
    location: "Remote",
    logo: internshala,
    period: "Dec 2019 - Jun 2020",
    website: "https://internshala.com/",
    roles: [
      {
        title: "Teaching Assistant Intern",
        period: "Dec 2019 - Jun 2020",
        highlights: [
          "Evaluated 200+ intern full-stack projects",
          "Curriculum development for web technologies"
        ],
        tech: ["JS", "HTML", "CSS", "PHP", "MySQL"]
      }
    ]
  },
  {
    name: "Infinocto",
    location: "Remote",
    logo: infinocto,
    period: "Dec 2018 - Jan 2019",
    roles: [
      {
        title: "Web Developer Intern",
        period: "Dec 2018 - Jan 2019",
        highlights: [
          "Website development & 360° viewer integration"
        ],
        tech: ["JS", "HTML", "CSS", "PHP"]
      }
    ]
  }
];
---

<section class="experience-section">
  <div class="container-bg">
    <h3 class="section-header">
      <span class="prompt">&gt;</span> cat experience.log<span class="terminal-cursor"></span>
    </h3>

    <div class="timeline">
      {companies.map((company, idx) => (
        <div class="timeline-item">
          <div class="timeline-marker">
            <div class="timeline-dot"></div>
            {idx < companies.length - 1 && <div class="timeline-line"></div>}
          </div>

          <div class="timeline-content">
            <div class="company-header">
              <Image src={company.logo} class={`company-logo ${company.logoClass || ''}`} alt={`${company.name} logo`} />
              <div class="company-info">
                <h4 class="company-name">
                  {company.name}
                  <span class="company-location">· {company.location}</span>
                </h4>
                <span class="company-period">{company.period}</span>
                {company.website && (
                  <a href={company.website} target="_blank" class="company-link">
                    <i class="fa fa-external-link-alt"></i>
                  </a>
                )}
              </div>
            </div>

            <div class="roles">
              {company.roles.map((role, rIdx) => (
                <div class={`role ${rIdx > 0 ? 'role-subsequent' : ''}`}>
                  <div class="role-header">
                    <span class="role-title">{role.title}</span>
                    <span class="role-period">{role.period}</span>
                  </div>

                  <ul class="role-highlights">
                    {role.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>

                  <div class="role-tech">
                    {role.tech.map((t) => (
                      <span class="tech-tag">{t}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    padding: 4rem 0;
    background: var(--bg-primary);
    transition: background-color 0.3s ease;
  }

  .timeline {
    position: relative;
  }

  .timeline-item {
    display: flex;
    gap: 1.5rem;
    position: relative;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 20px;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--timeline-dot);
    border: 2px solid var(--bg-primary);
    box-shadow: 0 0 0 3px var(--accent-light);
    flex-shrink: 0;
    margin-top: 6px;
    z-index: 1;
    transition: background-color 0.3s ease;
  }

  .timeline-line {
    width: 2px;
    flex-grow: 1;
    background: var(--timeline-line);
    margin: 4px 0;
    transition: background-color 0.3s ease;
  }

  .timeline-content {
    flex: 1;
    padding-bottom: 2.5rem;
  }

  .company-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .company-logo {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    object-fit: contain;
    background: var(--bg-secondary);
    padding: 4px;
    flex-shrink: 0;
    transition: background-color 0.3s ease;
  }

  .company-logo.logo-wide {
    width: 56px;
    height: 32px;
    border-radius: 6px;
  }

  .company-info {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .company-name {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .company-location {
    font-weight: 400;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .company-period {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .company-link {
    font-size: 0.75rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .company-link:hover {
    color: var(--accent);
  }

  .roles {
    margin-top: 0.25rem;
  }

  .role {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    margin-bottom: 0.5rem;
    transition: all 0.3s ease;
  }

  .role:hover {
    border-color: var(--border);
    box-shadow: var(--card-shadow);
  }

  .role-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .role-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
  }

  .role-period {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .role-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem 0;
  }

  .role-highlights li {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
    padding: 0.1rem 0;
    padding-left: 1rem;
    position: relative;
  }

  .role-highlights li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .role-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tech-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--tag-text);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  @media (max-width: 768px) {
    .experience-section {
      padding: 3rem 0;
    }

    .timeline-item {
      gap: 1rem;
    }

    .timeline-marker {
      width: 16px;
    }

    .timeline-dot {
      width: 10px;
      height: 10px;
    }

    .company-header {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .company-info {
      gap: 0.4rem;
    }

    .company-name {
      font-size: 1rem;
    }

    .role {
      padding: 0.6rem 0.75rem;
    }

    .role-header {
      flex-direction: column;
      gap: 0.1rem;
    }

    .role-highlights li {
      font-size: 0.78rem;
    }
  }
</style>
