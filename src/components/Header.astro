---
interface Props {
  title?: string;
  home?: string;
  blogs?: string;
  active?: string;
}

const { title = "Mohammad Anas" } = Astro.props;
const { home = "/" } = Astro.props;
const { blogs = "/blog" } = Astro.props;
const { active = "/blog" } = Astro.props;
---

<nav class="navbar navbar-expand-lg navbar-light fixed-top" style="background-color : #fff;">
  <a class="navbar-brand" href={home} style="color:#4D57DE;"><h2>{title}</h2></a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
  </button>
  
  <div class="collapse navbar-collapse " id="navbarSupportedContent">
     <div class="container">
          <ul class="navbar-nav mr-auto justify-content-end ">
              <li class=`nav-item ${active === home ? 'active' : ''}`>
                  <a class="nav-link" href={home}><b>main()</b></a>
              </li>
              <li class=`nav-item ${active !== home ? 'active' : ''}`>
                  <a class="nav-link" href={blogs}><b>blogs()</b></a>
              </li>
              <li class=`nav-item`>
                  <a class="nav-link" href="mailto:mail@mohdanas.me"><b>contact()</b></a>
              </li>
          </ul>
     </div>
  </div>
</nav>

<style>
  .navbar{
    color: black ;
    padding-left: 10% ;
    padding-right: 10% ;
    padding-top: 1vh;
    padding-bottom: 0.5vh;
    height: 6vh;
    font-family: 'Courier New', Courier, monospace;
  }

  .navbar-brand{
    font-family: 'Lobster', cursive;
    font-weight: 800;
  }

  .navbar-toggler{
    padding: 0.1rem 0.35rem;
    font-size: 1rem;
  }
  
