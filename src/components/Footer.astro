---
import VisitorCounter from './VisitorCounter.astro';
---

<footer class="status-bar">
  <div class="status-left">
    <span class="status-item branch">
      <i class="fas fa-code-branch"></i> main
    </span>
    <span class="status-item">
      <i class="fas fa-map-marker-alt"></i> Delhi, IN
    </span>
    <span class="status-item status-available">
      <span class="status-dot"></span> open to collab
    </span>
  </div>
  <div class="status-right">
    <span class="status-item">
      <i class="fas fa-briefcase"></i> 5+ yrs @ Adobe
    </span>
    <a href="https://github.com/anasM0hammad" target="_blank" class="status-item status-link">
      <i class="fab fa-github"></i>
    </a>
    <a href="https://www.linkedin.com/in/anasm0hammad/" target="_blank" class="status-item status-link">
      <i class="fab fa-linkedin-in"></i>
    </a>
    <span class="status-item"><VisitorCounter /></span>
    <span class="status-item">&copy; 2026 Anas</span>
  </div>
</footer>

<style>
  .status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    height: 28px;
    background: var(--accent);
    color: rgba(255, 255, 255, 0.9);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    position: relative;
    z-index: 100;
    transition: background-color 0.3s ease;
  }

  .status-left,
  .status-right {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0 0.6rem;
    height: 28px;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .status-item:hover {
    background: rgba(0, 0, 0, 0.15);
  }

  .status-link {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    cursor: pointer;
  }

  .status-link:hover {
    color: #fff;
    background: rgba(0, 0, 0, 0.2);
  }

  .branch {
    background: rgba(0, 0, 0, 0.1);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: #7ee787;
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (max-width: 768px) {
    .status-bar {
      font-size: 0.6rem;
      padding: 0 0.5rem;
      height: 26px;
    }

    .status-item {
      padding: 0 0.35rem;
      height: 26px;
    }

    .status-available {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .status-bar {
      font-size: 0.55rem;
      padding: 0 0.35rem;
      height: 24px;
    }

    .status-item {
      padding: 0 0.25rem;
      height: 24px;
      gap: 0.2rem;
    }

    .status-right .fa-briefcase {
      display: none;
    }

    .status-right span:last-child {
      display: none;
    }
  }
</style>
