---
interface Props {
  title: string;
  description: string;
  github?: string;
  href?: string;
  tags: string[];
  commits?: number;
}

const { title, description, github, href, tags, commits } = Astro.props;

---


<div class="card project-card">
    <div class="card-body">
        <h5>{title}</h5>
        <p class="description">{description}</p>
        <div class="tags">
            { tags.map((tag: string) => <span class="badge badge-pill badge-primary mr-1">{tag}</span> ) }
        </div>
        <div>
            { github && <a href={github} class="icons"><i class="fab fa-github"></i></a>}
            { href && <a href={href} style="left: 30px" class="icons"><i class="fas fa-link"></i></a>}
            { commits && <a href={github} style="left: 60px" class="icons"><i class="fas fa-code"></i>{commits}</a>}
        </div>
    </div>
</div>


<style>
    .project-card {
        border-radius: 8px;
        background-color: var(--bg-secondary);
        margin-bottom: 10px;
        border: 1px solid var(--border-light);
        transition: all 0.3s ease;
    }

    .project-card:hover {
        border-color: var(--border);
        box-shadow: var(--card-shadow);
    }

    .project-card h5 {
        color: var(--text-primary);
    }

    .tags{
        margin-bottom: 30px;
    }

    .description{
        font-size: 15px;
        color: var(--text-muted);
    }

    .icons{
        position: absolute;
        bottom: 10px;
        font-size: medium;
        color: var(--text-muted);
        transition: color 0.2s ease;
    }

    .icons:hover {
        color: var(--accent);
    }

    @media(max-width: 850px) {
        .project-card {
           margin-bottom: 10px;
        }
    }

</style>
