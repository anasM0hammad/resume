---
import PieChart from "./PieChart.astro";
import ProjectCard from "./ProjectCard.astro";
import { Image } from "astro:assets";
import profile from '../assets/profile.png';
import javascriptWhite from './../assets/javascript-white.svg';
import typescriptWhite from './../assets/typescript-white.svg';
import astro from './../assets/astro.svg';
import angular from './../assets/angular.svg';
import blockchain from './../assets/blockchain.svg';
import cpp from './../assets/cpp.svg';
import docker from './../assets/docker.svg';
import express from './../assets/express.svg';
import java from './../assets/java.svg';
import mongodb from './../assets/mongodb.svg';
import nextjs from './../assets/nextjs.svg';
import nodejs from './../assets/nodejs.svg';
import openai from './../assets/openai.svg';
import python from './../assets/python.svg';
import react from './../assets/react.svg';
import solidity from './../assets/solidity.svg';
import threejs from './../assets/threejs.svg';
import ollama from './../assets/ollama.svg';
import langchain from './../assets/langchain.svg';
import chroma from './../assets/chroma.svg';
import reactNative from './../assets/react-native.svg';


interface Project {
  title: string;
  description: string;
  github?: string;
  href?: string;
  tags: string[];
  commits?: number;
}
interface Technology {
    image: any,
    title: string
}

const projects: Project[] = [
    {
        title: "dMed",
        description: "dMed enables storing Electronic Health Records on the Ethereum blockchain using the ERC-721 protocol for NFTs. Prescriptions created by doctors are stored as NFTs on IPFS",
        tags: ['blockchain', 'solidity', 'ethereum', 'React.js', 'Node.js', 'web3.js', 'NFT', 'ERC-721', 'IPFS'],
        github: "https://github.com/anasM0hammad/dMed_frontend",
        commits: 20,
    },
    {
        title: "FormAI",
        description: "FormAI is a chrome extension that automates the process of filling job application forms. Simply click on fill form on the website, and the bot handles the rest - from field detection to intelligent response generation.",
        tags: ['Langchain', 'Chroma', 'Typescript', 'AI', 'Embeddings', 'RAG', 'AgentQL', 'OpenAI', 'Extension', 'React'],
        github: "https://github.com/anasM0hammad/formAI-ext",
        commits: 9,
    },
    {
        title: "spaceZ",
        description: "A C++ based desktop arcade game created using SFML library",
        tags: ['C++', 'SFML', 'Game Dev', 'XCode', 'Python'],
        github: "https://github.com/anasM0hammad/spaceZ",
        commits: 5,
    },
    {
        title: "Game Box",
        description: "A collection of Javascript based 2D games for browser using HTML5 canvas",
        tags: ['Javascript', 'Canvas', 'Game Dev', 'Web'],
        github: "https://github.com/anasM0hammad/Game-Box",
        commits: 64,
    }
]

// Fetch GitHub stats at BUILD TIME (server-side, no rate limit issues)
let ghData = { repos: 56, followers: 19, stars: 57, commits: 817 };
try {
  const userRes = await fetch('https://api.github.com/users/anasM0hammad');
  if (userRes.ok) {
    const user = await userRes.json();
    if (user.public_repos !== undefined) {
      ghData.repos = user.public_repos;
      ghData.followers = user.followers || 18;
    }

    // Fetch all repos to sum stars
    let totalStars = 0;
    let page = 1;
    while (true) {
      const reposRes = await fetch(`https://api.github.com/users/anasM0hammad/repos?per_page=100&page=${page}`);
      if (!reposRes.ok) break;
      const repos = await reposRes.json();
      if (!repos.length) break;
      for (const r of repos) totalStars += (r.stargazers_count || 0);
      if (repos.length < 100) break;
      page++;
    }
    ghData.stars = totalStars || 57;
  }
} catch (e) {
  // Build-time fetch failed, use fallback values
}

const technologies: Technology[] = [
    { image: javascriptWhite, title: 'JavaScript'},
    { image: typescriptWhite, title: 'TypeScript'},
    { image: react, title: 'React'},
    { image: reactNative, title: 'React Native'},
    { image: nextjs, title: 'Next.js'},
    { image: angular, title: 'Angular'},
    { image: nodejs, title: 'Node.js'},
    { image: express, title: 'Express'},
    { image: cpp, title: 'C++'},
    { image: openai, title: 'OpenAI'},
    { image: solidity, title: 'Solidity'},
    { image: blockchain, title: 'Blockchain'},
    { image: python, title: 'Python'},
    { image: java, title: 'Java'},
    { image: mongodb, title: 'MongoDB'},
    { image: astro, title: 'Astro'},
    { image: docker, title: 'Docker'},
    { image: threejs, title: 'Three.js'},
    { image: ollama, title: 'Ollama'},
    { image: langchain, title: 'Langchain'},
    { image: chroma, title: 'Chroma'}
]
---

<div class="container-bg profile-details">
    <div class="row my-2 d-flex align-items-stretch">
        <div class="col-lg-8 colx d-flex">
            <div class="card box w-100">
                <div class="card-body intro">
                    <div class="intro-header">
                        <div class="intro-profile-wrap" id="profile-tilt">
                            <Image src={profile} class="intro-profile-img" alt="Mohammad Anas"/>
                        </div>
                        <div class="intro-text">
                            <h3 class="monospace-font section-title">Introduction</h3>
                            <p class="handle"><small><b>@anaslyzer</b></small></p>
                        </div>
                    </div>
                    <p>Hey there I am Anas, an AI full-stack engineer from Delhi. I've spent the last few years building things that scale at Adobe and Samsung, and tinkering with side projects in healthtech, blockchain and AI . I love clean architecture, expressive code, and solving problems that matter.</p>
                    <p>Beyond coding, I'm a self-learned guitarist who loves experimenting with melodies, a beginner table tennis player, and a fitness enthusiast—committed to working out at least four times a week. I believe building great software is a lot like learning music or sport: it takes discipline, curiosity, and rhythm.</p>
                    <br/>
                </div>
            </div>
        </div>
        <div class="col-lg-4 colx d-flex">
            <div class="card box w-100">
                <div class="card-body stats">
                    <h3 class="monospace-font section-title">Github Space</h3>
                    <div class="d-flex m-4 github-stats-row">
                        <div class="text-center git-stats">
                            <i class="fa fa-bookmark stat-icon"></i>
                            <small class="stat-value">{ghData.repos}</small>
                            <small class="stat-label">Repositories</small>
                        </div>
                        <div class="text-center git-stats">
                            <i class="fa fa-user-plus stat-icon"></i>
                            <small class="stat-value">{ghData.followers}</small>
                            <small class="stat-label">Followers</small>
                        </div>
                        <div class="text-center git-stats">
                            <i class="fa fa-star stat-icon"></i>
                            <small class="stat-value">{ghData.stars}</small>
                            <small class="stat-label">Stars</small>
                        </div>
                        <div class="text-center git-stats">
                            <i class="fa fa-code stat-icon"></i>
                            <small class="stat-value">{ghData.commits}</small>
                            <small class="stat-label">Commits</small>
                        </div>
                    </div>
                    <p class="monospace-font"><b>Languages Used:</b></p>
                    <PieChart />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8 colx">
            <div class="card box technology">
                <div class="card-body" style="padding-top: 40px; padding-bottom: 40px">
                    <h3 class="monospace-font section-title">Personal Garage</h3>
                    <div class="row">
                        {
                            projects.map((project) => <div class="col-lg-6 colx"><ProjectCard title={project.title} description={project.description} tags={project.tags} github={project?.github} href={project.href} commits={project.commits}/></div> )
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 colx">
            <div class="card box">
                <div class="card-body tech-stack-card">
                    <h3 class="monospace-font section-title">Tech Stack</h3>
                    <div class="tech-grid">
                        {
                            technologies.map((technology: Technology) => {
                                return (
                                <div class="tech-item">
                                    <div class="tech-icon-wrap">
                                        <Image src={technology.image} class="tech-icon"  alt={`${technology.title} logo`}/>
                                    </div>
                                    <span class="tech-label">{technology.title}</span>
                                </div>
                                )
                            })
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
  // Profile image 3D tilt (same effect as terminal)
  document.addEventListener('DOMContentLoaded', function() {
    const profileWrap = document.getElementById('profile-tilt');
    if (!profileWrap) return;

    profileWrap.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = profileWrap.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      const rotateY = (x - 0.5) * 15;
      const rotateX = (0.5 - y) * 15;
      profileWrap.style.transform = `perspective(400px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      profileWrap.style.transition = 'none';
    });

    profileWrap.addEventListener('mouseleave', () => {
      profileWrap.style.transition = 'transform 0.4s ease';
      profileWrap.style.transform = 'perspective(400px) rotateX(0) rotateY(0)';
    });
  });
</script>

<style>

    .profile-details{
       margin-top: 5vh;
       margin-bottom: 5vh;
    }

    .colx{
        padding-left: 4px;
        padding-right: 4px;
    }

    .section-title {
        color: var(--accent) !important;
    }

    .card-body h3{
        color: var(--accent);
    }

    .card{
        border: none;
        border-radius: 10px;
    }

    .handle {
        color: var(--accent) !important;
    }

    /* ============================================
       INTRO HEADER - Profile image on LEFT with 3D tilt
       ============================================ */
    .intro-header {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 1rem;
    }

    .intro-text {
        flex: 1;
    }

    .intro-profile-wrap {
        flex-shrink: 0;
        will-change: transform;
        transform-style: preserve-3d;
    }

    .intro-profile-img {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--accent);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        display: block;
    }

    .git-stats{
        color: var(--text-muted);
        display: inline-grid;
    }

    .stat-icon {
        color: var(--accent);
    }

    .stat-value {
        color: var(--accent);
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
    }

    .stat-label {
        color: var(--text-muted);
    }

    .github-stats-row {
        justify-content: space-between;
    }

    .technology{
        height: 100%;
    }

    .stats{
        padding-top: 40px;
        padding-bottom: 40px
    }

    .intro{
        padding: 40px 60px;
    }

    /* ============================================
       TECH STACK — Big icons, dark mode visible
       ============================================ */
    .tech-stack-card {
        padding: 30px 20px;
    }

    .tech-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .tech-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        padding: 0.6rem 0.25rem;
        border-radius: 10px;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        cursor: default;
    }

    .tech-item:hover {
        background: var(--accent-light);
        transform: translateY(-4px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

    [data-theme="dark"] .tech-item:hover {
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }

    .tech-icon-wrap {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        perspective: 200px;
        transition: background-color 0.3s ease;
    }

    /* Dark mode: give icons a subtle light bg so they're visible */
    [data-theme="dark"] .tech-icon-wrap {
        background: rgba(255, 255, 255, 0.08);
    }

    .tech-icon {
        width: 48px;
        height: 48px;
        object-fit: contain;
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    /* Dark mode: boost icon brightness */
    [data-theme="dark"] .tech-icon {
        filter: brightness(1.3) contrast(1.05);
    }

    .tech-item:hover .tech-icon {
        transform: scale(1.18) rotateX(8deg);
    }

    .tech-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.62rem;
        font-weight: 500;
        color: var(--text-muted);
        text-align: center;
        white-space: nowrap;
    }

    /* Dark mode: make labels more readable */
    [data-theme="dark"] .tech-label {
        color: var(--text-secondary);
    }

    @media (min-width: 851px){
        .profile-details p{
            font-size: medium;
        }
    }

    @media (max-width: 850px){
        .colx{
            margin: 10px;
        }

        .stats{
            padding-top: 10px;
            padding-bottom: 10px
        }

        .intro{
            padding: 20px;
        }

        .profile-details p{
            font-size: small;
        }

        .tech-grid {
            grid-template-columns: repeat(5, 1fr);
            gap: 0.5rem;
        }

        .tech-icon {
            width: 40px;
            height: 40px;
        }

        .tech-icon-wrap {
            width: 48px;
            height: 48px;
        }

        .intro-profile-img {
            width: 80px;
            height: 80px;
        }

        .github-stats-row {
            flex-wrap: wrap;
            gap: 0.5rem;
            margin: 1rem !important;
        }

        .git-stats {
            min-width: 60px;
        }
    }

    @media (max-width: 480px) {
        .tech-grid {
            grid-template-columns: repeat(4, 1fr);
            gap: 0.4rem;
        }

        .tech-icon {
            width: 36px;
            height: 36px;
        }

        .tech-icon-wrap {
            width: 42px;
            height: 42px;
        }

        .profile-details p{
            font-size: small;
            line-height: 1.6;
        }

        .intro-profile-img {
            width: 60px;
            height: 60px;
        }

        .intro{
            padding: 15px;
        }

        .intro-header {
            gap: 0.75rem;
        }

        .colx{
            margin: 5px;
        }

        .github-stats-row {
            margin: 0.5rem !important;
        }

        .stat-icon {
            font-size: 0.85rem;
        }

        .stat-value {
            font-size: 0.8rem;
        }

        .stat-label {
            font-size: 0.65rem;
        }

        .tech-label {
            font-size: 0.55rem;
        }
    }

</style>
