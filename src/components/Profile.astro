---
import PieChart from "./PieChart.astro";
import ProjectCard from "./ProjectCard.astro";
import { Image } from "astro:assets";
import profile from '../assets/profile.png';
import javascriptWhite from './../assets/javascript-white.svg';
import typescriptWhite from './../assets/typescript-white.svg';
import astro from './../assets/astro.svg';
import angular from './../assets/angular.svg';
import blockchain from './../assets/blockchain.svg';
import cpp from './../assets/cpp.svg';
import docker from './../assets/docker.svg';
import express from './../assets/express.svg';
import java from './../assets/java.svg';
import mongodb from './../assets/mongodb.svg';
import nextjs from './../assets/nextjs.svg';
import nodejs from './../assets/nodejs.svg';
import openai from './../assets/openai.svg';
import python from './../assets/python.svg';
import react from './../assets/react.svg';
import solidity from './../assets/solidity.svg';
import threejs from './../assets/threejs.svg';
import ollama from './../assets/ollama.svg';
import langchain from './../assets/langchain.svg';
import chroma from './../assets/chroma.svg';
import reactNative from './../assets/react-native.svg';


interface Project {
  title: string;
  description: string;
  github?: string;
  href?: string;
  tags: string[];
  commits?: number;
}
interface Technology {
    image: any,
    title: string
}

const projects: Project[] = [
    {
        title: "dMed",
        description: "dMed enables storing Electronic Health Records on the Ethereum blockchain using the ERC-721 protocol for NFTs. Prescriptions created by doctors are stored as NFTs on IPFS",
        tags: ['blockchain', 'solidity', 'ethereum', 'React.js', 'Node.js', 'web3.js', 'NFT', 'ERC-721', 'IPFS'],
        github: "https://github.com/anasM0hammad/dMed_frontend",
        commits: 20,
    },
    {
        title: "FormAI",
        description: "FormAI is a chrome extension that automates the process of filling job application forms. Simply click on fill form on the website, and the bot handles the rest - from field detection to intelligent response generation.",
        tags: ['Langchain', 'Chroma', 'Typescript', 'AI', 'Embeddings', 'RAG', 'AgentQL', 'OpenAI', 'Extension', 'React'],
        github: "https://github.com/anasM0hammad/formAI-ext",
        commits: 9,
    },
    {
        title: "spaceZ",
        description: "A C++ based desktop arcade game created using SFML library",
        tags: ['C++', 'SFML', 'Game Dev', 'XCode', 'Python'],
        github: "https://github.com/anasM0hammad/spaceZ",
        commits: 5,
    },
    {
        title: "Game Box",
        description: "A collection of Javascript based 2D games for browser using HTML5 canvas",
        tags: ['Javascript', 'Canvas', 'Game Dev', 'Web'],
        github: "https://github.com/anasM0hammad/Game-Box",
        commits: 64,
    }
]

const technologies: Technology[] = [
    { image: javascriptWhite, title: 'JavaScript'},
    { image: typescriptWhite, title: 'TypeScript'},
    { image: react, title: 'React'},
    { image: reactNative, title: 'React Native'},
    { image: nextjs, title: 'Next.js'},
    { image: angular, title: 'Angular'},
    { image: nodejs, title: 'Node.js'},
    { image: express, title: 'Express'},
    { image: cpp, title: 'C++'},
    { image: openai, title: 'OpenAI'},
    { image: solidity, title: 'Solidity'},
    { image: blockchain, title: 'Blockchain'},
    { image: python, title: 'Python'},
    { image: java, title: 'Java'},
    { image: mongodb, title: 'MongoDB'},
    { image: astro, title: 'Astro'},
    { image: docker, title: 'Docker'},
    { image: threejs, title: 'Three.js'},
    { image: ollama, title: 'Ollama'},
    { image: langchain, title: 'Langchain'},
    { image: chroma, title: 'Chroma'}
]
---

<div class="container-bg profile-details">
    <div class="row my-2">
        <div class="col-lg-8 colx">
            <div class="card box">
                <div class="card-body intro">
                    <div class="intro-header">
                        <div class="intro-text">
                            <h3 class="monospace-font section-title">Introduction</h3>
                            <p class="handle"><small><b>@anaslyzer</b></small></p>
                        </div>
                        <div class="intro-profile-wrap">
                            <Image src={profile} class="intro-profile-img" alt="Mohammad Anas"/>
                            <div class="profile-glow"></div>
                        </div>
                    </div>
                    <p>Hey there I am Anas, an AI full-stack engineer from Delhi. I've spent the last few years building things that scale at Adobe and Samsung, and tinkering with side projects in healthtech, blockchain and AI . I love clean architecture, expressive code, and solving problems that matter.</p>
                    <p>Beyond coding, I'm a self-learned guitarist who loves experimenting with melodies, a beginner table tennis player, and a fitness enthusiast—committed to working out at least four times a week. I believe building great software is a lot like learning music or sport: it takes discipline, curiosity, and rhythm.</p>
                    <br/>
                </div>
            </div>
        </div>
        <div class="col-lg-4 colx">
            <div class="card box">
                <div class="card-body stats">
                    <h3 class="monospace-font section-title">Github Space</h3>
                    <div class="d-flex m-4 github-stats-row">
                        <div class="text-center git-stats">
                            <i class="fa fa-bookmark stat-icon"></i>
                            <small class="stat-value" id="gh-repos">--</small>
                            <small class="stat-label">Repositories</small>
                        </div>
                        <div class="text-center git-stats">
                            <i class="fa fa-user-plus stat-icon"></i>
                            <small class="stat-value" id="gh-followers">--</small>
                            <small class="stat-label">Followers</small>
                        </div>
                        <div class="text-center git-stats">
                            <i class="fa fa-star stat-icon"></i>
                            <small class="stat-value" id="gh-stars">--</small>
                            <small class="stat-label">Stars</small>
                        </div>
                        <div class="text-center git-stats">
                            <i class="fa fa-code stat-icon"></i>
                            <small class="stat-value" id="gh-commits">--</small>
                            <small class="stat-label">Commits</small>
                        </div>
                    </div>
                    <p class="monospace-font"><b>Languages Used:</b></p>
                    <PieChart />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8 colx">
            <div class="card box technology">
                <div class="card-body" style="padding-top: 40px; padding-bottom: 40px">
                    <h3 class="monospace-font section-title">Personal Garage</h3>
                    <div class="row">
                        {
                            projects.map((project) => <div class="col-lg-6 colx"><ProjectCard title={project.title} description={project.description} tags={project.tags} github={project?.github} href={project.href} commits={project.commits}/></div> )
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 colx">
            <div class="card box">
                <div class="card-body tech-stack-card">
                    <h3 class="monospace-font section-title">Tech Stack</h3>
                    <div class="tech-grid">
                        {
                            technologies.map((technology: Technology) => {
                                return (
                                <div class="tech-item">
                                    <div class="tech-icon-wrap">
                                        <Image src={technology.image} class="tech-icon"  alt={`${technology.title} logo`}/>
                                    </div>
                                    <span class="tech-label">{technology.title}</span>
                                </div>
                                )
                            })
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
  // GitHub API integration — fetch live stats
  async function fetchGitHubStats() {
    const username = 'anasM0hammad';
    try {
      // Fetch user profile
      const userRes = await fetch(`https://api.github.com/users/${username}`);
      if (!userRes.ok) {
        console.warn('GitHub API user fetch failed:', userRes.status);
        setFallbackValues();
        return;
      }
      const user = await userRes.json();

      const reposEl = document.getElementById('gh-repos');
      const followersEl = document.getElementById('gh-followers');
      if (reposEl) reposEl.textContent = (user.public_repos ?? 0).toString();
      if (followersEl) followersEl.textContent = (user.followers ?? 0).toString();

      // Fetch all repos (paginated) to calculate total stars
      let allRepos: any[] = [];
      let page = 1;
      let hasMore = true;
      while (hasMore) {
        const reposRes = await fetch(`https://api.github.com/users/${username}/repos?per_page=100&page=${page}&sort=updated`);
        if (!reposRes.ok) break;
        const repos = await reposRes.json();
        if (repos.length === 0) {
          hasMore = false;
        } else {
          allRepos = allRepos.concat(repos);
          page++;
          if (repos.length < 100) hasMore = false;
        }
      }

      const totalStars = allRepos.reduce((sum: number, repo: any) => sum + (repo.stargazers_count || 0), 0);
      const starsEl = document.getElementById('gh-stars');
      if (starsEl) starsEl.textContent = totalStars.toString();

      // Fetch recent events to estimate commit activity
      const eventsRes = await fetch(`https://api.github.com/users/${username}/events?per_page=100`);
      if (eventsRes.ok) {
        const events = await eventsRes.json();
        const pushEvents = events.filter((e: any) => e.type === 'PushEvent');
        const recentCommits = pushEvents.reduce((sum: number, e: any) => sum + (e.payload?.commits?.length || 0), 0);
        const commitsEl = document.getElementById('gh-commits');
        // Show recent commits count with a "+" to indicate it's recent activity
        if (commitsEl) commitsEl.textContent = recentCommits > 0 ? `${recentCommits}+` : '374';
      }
    } catch (err) {
      console.warn('GitHub API error:', err);
      setFallbackValues();
    }
  }

  function setFallbackValues() {
    const fallbacks: Record<string, string> = {
      'gh-repos': '56',
      'gh-followers': '18',
      'gh-stars': '57',
      'gh-commits': '374'
    };
    Object.entries(fallbacks).forEach(([id, val]) => {
      const el = document.getElementById(id);
      if (el && el.textContent === '--') el.textContent = val;
    });
  }

  fetchGitHubStats();
</script>

<style>

    .profile-details{
       margin-top: 5vh;
       margin-bottom: 5vh;
    }

    .colx{
        padding-left: 4px;
        padding-right: 4px;
    }

    .section-title {
        color: var(--accent) !important;
    }

    .card-body h3{
        color: var(--accent);
    }

    .card{
        border: none;
        border-radius: 10px;
    }

    .handle {
        color: var(--accent) !important;
    }

    /* ============================================
       INTRO HEADER - Profile image inline
       ============================================ */
    .intro-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 0.75rem;
    }

    .intro-text {
        flex: 1;
    }

    .intro-profile-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .intro-profile-img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--accent);
        box-shadow: 0 0 20px var(--accent-glow), 0 4px 16px rgba(0, 0, 0, 0.1);
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .intro-profile-img:hover {
        transform: scale(1.05);
        box-shadow: 0 0 30px var(--accent-glow), 0 0 50px var(--accent-glow);
    }

    .profile-glow {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        background: conic-gradient(var(--accent), transparent, var(--accent));
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: -1;
        filter: blur(8px);
    }

    .intro-profile-wrap:hover .profile-glow {
        opacity: 0.4;
    }

    .git-stats{
        color: var(--text-muted);
        display: inline-grid;
    }

    .stat-icon {
        color: var(--accent);
    }

    .stat-value {
        color: var(--accent);
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
    }

    .stat-label {
        color: var(--text-muted);
    }

    .github-stats-row {
        justify-content: space-between;
    }

    .technology{
        height: 100%;
    }

    .stats{
        padding-top: 40px;
        padding-bottom: 40px
    }

    .intro{
        padding: 40px 60px;
    }

    /* ============================================
       TECH STACK — Bigger icons with 3D hover
       ============================================ */
    .tech-stack-card {
        padding: 30px 20px;
    }

    .tech-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .tech-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        padding: 0.6rem 0.25rem;
        border-radius: 10px;
        transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        cursor: default;
    }

    .tech-item:hover {
        background: var(--accent-light);
        transform: translateY(-4px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

    [data-theme="dark"] .tech-item:hover {
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }

    .tech-icon-wrap {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        perspective: 200px;
    }

    .tech-icon {
        width: 48px;
        height: 48px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .tech-item:hover .tech-icon {
        transform: scale(1.18) rotateX(8deg);
    }

    .tech-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.62rem;
        font-weight: 500;
        color: var(--text-muted);
        text-align: center;
        white-space: nowrap;
    }

    @media (min-width: 851px){
        .profile-details p{
            font-size: medium;
        }
    }

    @media (max-width: 850px){
        .colx{
            margin: 10px;
        }

        .stats{
            padding-top: 10px;
            padding-bottom: 10px
        }

        .intro{
            padding: 20px;
        }

        .profile-details p{
            font-size: small;
        }

        .tech-grid {
            grid-template-columns: repeat(5, 1fr);
            gap: 0.5rem;
        }

        .tech-icon {
            width: 40px;
            height: 40px;
        }

        .tech-icon-wrap {
            width: 48px;
            height: 48px;
        }

        .intro-profile-img {
            width: 90px;
            height: 90px;
        }
    }

    @media (max-width: 480px) {
        .tech-grid {
            grid-template-columns: repeat(4, 1fr);
            gap: 0.4rem;
        }

        .tech-icon {
            width: 36px;
            height: 36px;
        }

        .tech-icon-wrap {
            width: 42px;
            height: 42px;
        }

        .profile-details p{
            font-size: small;
        }

        .intro-header {
            flex-direction: column-reverse;
            align-items: center;
            text-align: center;
        }

        .intro-profile-img {
            width: 80px;
            height: 80px;
        }
    }

</style>
