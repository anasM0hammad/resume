---
import dice3dImg from '../assets/Projects/dice3d.png';
import threeVertexImg from '../assets/Projects/three-vertex.png';
import flyingBalloonImg from '../assets/Projects/flying-balloon.png';
import wakeaiImg from '../assets/Projects/wakeai.png';
import formAI from '../assets/Projects/formai.png';

interface ProductLink {
  type: 'playstore' | 'appstore' | 'web' | 'chrome' | 'github';
  url: string;
}

interface Product {
  name: string;
  tagline: string;
  category: string;
  image: ImageMetadata;
  status: string;
  pricing: 'Free' | 'Paid';
  mrr?: string;
  highlights: { label: string; value: string }[];
  stats: { label: string; value: string }[];
  tech: string[];
  links: ProductLink[];
}

const products: Product[] = [
  {
    name: "Dice 3D",
    tagline: "A 3D interactive dice roller with realistic physics, customizable face values, uploadable face images, and multiple dice skins. Available cross-platform on web, Android, and iOS with RPG dice support, daily challenges, and rich theme options.",
    category: "Mobile App",
    image: dice3dImg,
    status: "Shipped",
    pricing: "Free",
    highlights: [
      { label: "Downloads", value: "100+" },
    ],
    stats: [
      { label: "Version", value: "v3.0.2" },
    ],
    tech: ["Three.js", "React", "Capacitor", "Typescript"],
    links: [
      { type: "playstore", url: "https://play.google.com/store/apps/details?id=com.anaslyzer.thedice" },
      { type: "web", url: "https://dice.threevertex.co" },
    ],
  },
  {
    name: "Three Vertex",
    tagline: "A 3D collaboration platform with support for viewing, uploading and sharing any 3D model. It supports model listing, user authentication and model management with inbuilt 3D model viewer. It let user annotate on the model with hotspot and realtime feedback",
    category: "Web Platform",
    image: threeVertexImg,
    status: "Shipped",
    pricing: "Free",
    highlights: [
      { label: "Models", value: "10+" },
    ],
    stats: [
      { label: "Version", value: "v2.0.0" },
    ],
    tech: ["Three.js", "Next.js", "Cloudflare", "Firebase", "R3F", "Typescript"],
    links: [
      { type: "web", url: "https://spaces.threevertex.co/" },
    ],
  },
  {
    name: "FormAI",
    tagline: "FormAI Extension is a Chrome extension that revolutionizes the job application process by automatically filling form fields with intelligent, context-aware responses. Built with privacy-first architecture, all your data stays local and encrypted on your device.",
    category: "Chrome Extension",
    image: formAI,
    status: "Shipped",
    pricing: "Free",
    highlights: [
      { label: "Downloads", value: "10+" },
    ],
    stats: [
      { label: "Version", value: "v2.0.0" },
    ],
    tech: ["Typescript", "React", "ManifestV3", "WebLLM", "AI"],
    links: [
      { type: "chrome", url: "https://chromewebstore.google.com/detail/formai/mkgoodfdechhjgclfojlckjebffffjmj" },
    ],
  },
  {
    name: "Flying Balloon",
    tagline: "A fast-paced tap-to-fly arcade game where you navigate a balloon through moving obstacles while collecting coins and unlocking skins. Features daily rewards, badge achievements, a local leaderboard, and progressive difficulty scaling.",
    category: "Mobile Game",
    image: flyingBalloonImg,
    status: "Shipped",
    pricing: "Free",
    highlights: [
      { label: "Downloads", value: "10+" },
    ],
    stats: [
      { label: "Version", value: "v1.3.0" },
    ],
    tech: ["Phaser 3", "React", "Capacitor", "Typescript"],
    links: [
      { type: "playstore", url: "https://play.google.com/store/apps/details?id=com.anaslyzer.flyingBalloon" },
    ],
  },
  {
    name: "WakeAI",
    tagline: "An intelligent alarm clock that uses on-device AI to generate quiz questions you must solve before the alarm stops. Supports multiple difficulty levels, offline functionality, and adaptive model selection based on your device's capabilities.",
    category: "Mobile App",
    image: wakeaiImg,
    status: "Development",
    pricing: "Free",
    highlights: [
      { label: "Downloads", value: "--" },
    ],
    stats: [
      { label: "Version", value: "1.0.0-beta" },
    ],
    tech: ["JavaScript", "React", "WebLLM", "OpenAI SDK", "Capacitor", "AI"],
    links: [
      { type: "github", url: "https://github.com/anasM0hammad/wake-ai" },
    ],
  },
];
---

<section class="products-section">
  <div class="container-bg">
    <h3 class="section-header">
      <span class="prompt">&gt;</span> ls ~/products<span class="terminal-cursor"></span>
    </h3>

    <div class="products-grid">
      {products.map((product) => (
        <div class="product-card">
          <div class="product-body">
            <div class="product-info">
              <div class="product-name-row">
                <h3 class="product-name">{product.name}</h3>
                <span class="product-status" data-status={product.status}>{product.status}</span>
                <span class="pricing-badge" data-pricing={product.pricing}>{product.pricing}</span>
                {product.pricing === 'Paid' && product.mrr && (
                  <div class="highlight-item">
                    <span class="highlight-val">{product.mrr}</span>
                    <span class="highlight-lbl">MRR</span>
                  </div>
                )}
                <div class="product-highlights">
                  {product.highlights.map((h) => (
                    <div class="highlight-item">
                      <span class="highlight-val">{h.value}</span>
                      <span class="highlight-lbl">{h.label}</span>
                    </div>
                  ))}
                </div>
              </div>
              <span class="product-category">{product.category}</span>
              <p class="product-tagline">{product.tagline}</p>
              {product.stats.length > 0 && (
                <div class="product-stats">
                  {product.stats.map((stat) => (
                    <span class="stat-item">
                      <span class="stat-val">{stat.value}</span>
                      <span class="stat-lbl">{stat.label}</span>
                    </span>
                  ))}
                </div>
              )}
              <div class="product-tech">
                {product.tech.map((t) => (
                  <span class="tech-pill">{t}</span>
                ))}
              </div>
              {product.links.length > 0 && (
                <div class="platform-links">
                  {product.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="platform-icon-link" title={
                      link.type === 'playstore' ? 'Google Play Store' :
                      link.type === 'appstore' ? 'Apple App Store' :
                      link.type === 'web' ? 'Website' :
                      link.type === 'chrome' ? 'Chrome Web Store' :
                      link.type === 'github' ? 'GitHub' : ''
                    }>
                      {link.type === 'playstore' && (
                        <svg class="platform-svg" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302-2.302 2.302L15.396 12l2.302-2.492zM5.864 2.658L16.801 8.99l-2.302 2.302-8.635-8.634z"/>
                        </svg>
                      )}
                      {link.type === 'appstore' && (
                        <svg class="platform-svg" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                        </svg>
                      )}
                      {link.type === 'web' && (
                        <svg class="platform-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"/>
                          <line x1="2" y1="12" x2="22" y2="12"/>
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                        </svg>
                      )}
                      {link.type === 'chrome' && (
                        <svg class="platform-svg" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.45 7.09l.002.001-3.953 6.848c.539.073 1.088.111 1.646.111 6.075 0 11.027-4.509 11.852-10.352h-7.906zM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"/>
                        </svg>
                      )}
                      {link.type === 'github' && (
                        <svg class="platform-svg" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                      )}
                    </a>
                  ))}
                </div>
              )}
            </div>
            <div class="product-icon-area">
              <img src={product.image.src} alt={product.name} class="product-logo" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .products-section {
    padding: 4rem 0;
    background: var(--bg-secondary);
    transition: background-color 0.3s ease;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* ── Pricing badge ── */
  .pricing-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .pricing-badge[data-pricing="Free"] {
    color: #27c93f;
    border: 1px solid rgba(39, 201, 63, 0.3);
  }

  .pricing-badge[data-pricing="Paid"] {
    color: #ffbd2e;
    border: 1px solid rgba(255, 189, 46, 0.3);
  }

  /* ── Highlights inline in title row ── */
  .product-highlights {
    display: flex;
    gap: 1rem;
    margin-left: auto;
  }

  .highlight-item {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }

  .highlight-val {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .highlight-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    gap: 1.5rem;
  }

  .product-info {
    flex: 1;
    min-width: 0;
  }

  .product-name-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.15rem;
  }

  .product-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .product-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .product-status[data-status="Development"] {
    color: #4a9eff;
    border: 1px solid rgba(74, 158, 255, 0.3);
  }

  .product-status[data-status="Shipped"] {
    color: #27c93f;
    border: 1px solid rgba(39, 201, 63, 0.3);
  }

  .product-status[data-status="Beta"] {
    color: #ffbd2e;
    border: 1px solid rgba(255, 189, 46, 0.3);
  }

  .product-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .product-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin: 0.4rem 0 0.6rem 0;
    line-height: 1.5;
  }

  .product-stats {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
  }

  .stat-val {
    font-weight: 700;
    color: var(--accent);
  }

  .stat-lbl {
    font-weight: 400;
    color: var(--text-muted);
    text-transform: lowercase;
  }

  .product-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.6rem;
  }

  .tech-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 500;
    color: var(--tag-text);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  /* ── Platform link icons ── */
  .platform-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .platform-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    color: var(--text-muted);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .platform-icon-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(var(--accent-rgb, 100, 100, 255), 0.08);
    transform: translateY(-1px);
  }

  .platform-svg {
    width: 16px;
    height: 16px;
  }

  .product-actions {
    display: flex;
    gap: 0.75rem;
  }

  .product-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.2s ease;
  }

  .product-link:hover {
    color: var(--accent);
  }

  /* Product logo on the right */
  .product-icon-area {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .product-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
  }

  .product-card:hover .product-icon-area {
    opacity: 1;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .products-section {
      padding: 3rem 0;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .product-body {
      padding: 1rem;
      gap: 0.75rem;
    }

    .product-name-row {
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .product-highlights {
      margin-left: 0;
      width: 100%;
      gap: 0.75rem;
    }

    .product-name {
      font-size: 1.05rem;
    }

    .product-tagline {
      font-size: 0.75rem;
    }

    .product-icon-area {
      width: 48px;
      height: 48px;
    }

    .highlight-val {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .product-body {
      padding: 0.85rem;
    }

    .product-name {
      font-size: 0.95rem;
    }

    .product-tagline {
      font-size: 0.72rem;
    }

    .tech-pill {
      font-size: 0.52rem;
    }
  }
</style>
