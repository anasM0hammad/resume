---
interface Product {
  name: string;
  tagline: string;
  category: string;
  icon: string;
  status: string;
  highlights: { label: string; value: string }[];
  stats: { label: string; value: string }[];
  tech: string[];
  sourceUrl?: string;
  liveUrl?: string;
}

const products: Product[] = [
  {
    name: "FormAI",
    tagline: "AI-powered chrome extension that automates job application forms using RAG pipeline.",
    category: "Chrome Extension",
    icon: "fas fa-brain",
    status: "Active",
    highlights: [
      { label: "MRR", value: "$0" },
      { label: "Users", value: "120+" },
    ],
    stats: [
      { label: "Stars", value: "9" },
      { label: "Version", value: "v1.2" },
    ],
    tech: ["Langchain", "OpenAI", "TypeScript", "React", "RAG"],
    sourceUrl: "https://github.com/anasM0hammad/formAI-ext",
  },
  {
    name: "dMed",
    tagline: "Electronic Health Records stored on Ethereum blockchain as NFTs using ERC-721.",
    category: "DApp",
    icon: "fas fa-heartbeat",
    status: "Shipped",
    highlights: [
      { label: "MRR", value: "$0" },
      { label: "Records", value: "50+" },
    ],
    stats: [
      { label: "Stars", value: "20" },
    ],
    tech: ["Solidity", "React", "Web3.js", "IPFS"],
    sourceUrl: "https://github.com/anasM0hammad/dMed_frontend",
  },
  {
    name: "spaceZ",
    tagline: "C++ desktop arcade game built with SFML. Dodge asteroids, shoot enemies.",
    category: "Desktop Game",
    icon: "fas fa-rocket",
    status: "Shipped",
    highlights: [
      { label: "Downloads", value: "50+" },
      { label: "Stars", value: "5" },
    ],
    stats: [],
    tech: ["C++", "SFML", "Game Dev"],
    sourceUrl: "https://github.com/anasM0hammad/spaceZ",
  },
  {
    name: "Game Box",
    tagline: "Collection of browser-based 2D games using HTML5 Canvas, pure vanilla JS.",
    category: "Web App",
    icon: "fas fa-dice",
    status: "Active",
    highlights: [
      { label: "Stars", value: "64" },
      { label: "Games", value: "5" },
    ],
    stats: [],
    tech: ["JavaScript", "Canvas", "HTML5"],
    sourceUrl: "https://github.com/anasM0hammad/Game-Box",
  },
];
---

<section class="products-section">
  <div class="container-bg">
    <h3 class="section-header">
      <span class="prompt">&gt;</span> ls ~/products<span class="terminal-cursor"></span>
    </h3>

    <div class="products-grid">
      {products.map((product) => (
        <a href={product.sourceUrl || "#"} target="_blank" rel="noopener" class="product-card">
          <div class="product-body">
            <div class="product-info">
              <div class="product-name-row">
                <h3 class="product-name">{product.name}</h3>
                <span class="product-status" data-status={product.status}>{product.status}</span>
                <div class="product-highlights">
                  {product.highlights.map((h) => (
                    <div class="highlight-item">
                      <span class="highlight-val">{h.value}</span>
                      <span class="highlight-lbl">{h.label}</span>
                    </div>
                  ))}
                </div>
              </div>
              <span class="product-category">{product.category}</span>
              <p class="product-tagline">{product.tagline}</p>
              {product.stats.length > 0 && (
                <div class="product-stats">
                  {product.stats.map((stat) => (
                    <span class="stat-item">
                      <span class="stat-val">{stat.value}</span>
                      <span class="stat-lbl">{stat.label}</span>
                    </span>
                  ))}
                </div>
              )}
              <div class="product-tech">
                {product.tech.map((t) => (
                  <span class="tech-pill">{t}</span>
                ))}
              </div>
              <div class="product-actions">
                {product.sourceUrl && (
                  <a href={product.sourceUrl} target="_blank" class="product-link">
                    <i class="fab fa-github"></i> Source
                  </a>
                )}
                {product.liveUrl && (
                  <a href={product.liveUrl} target="_blank" class="product-link">
                    <i class="fas fa-external-link-alt"></i> Live
                  </a>
                )}
              </div>
            </div>
            <div class="product-icon-area">
              <i class={product.icon}></i>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .products-section {
    padding: 4rem 0;
    background: var(--bg-secondary);
    transition: background-color 0.3s ease;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s ease, transform 0.2s ease;
    text-decoration: none;
    cursor: pointer;
    display: block;
    color: inherit;
  }

  .product-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* ── Highlights inline in title row ── */
  .product-highlights {
    display: flex;
    gap: 1rem;
    margin-left: auto;
  }

  .highlight-item {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }

  .highlight-val {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .highlight-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    gap: 1.5rem;
  }

  .product-info {
    flex: 1;
    min-width: 0;
  }

  .product-name-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.15rem;
  }

  .product-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .product-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .product-status[data-status="Active"] {
    color: #27c93f;
    border: 1px solid rgba(39, 201, 63, 0.3);
  }

  .product-status[data-status="Shipped"] {
    color: #61dafb;
    border: 1px solid rgba(97, 218, 251, 0.3);
  }

  .product-status[data-status="Beta"] {
    color: #ffbd2e;
    border: 1px solid rgba(255, 189, 46, 0.3);
  }

  .product-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .product-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin: 0.4rem 0 0.6rem 0;
    line-height: 1.5;
  }

  .product-stats {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
  }

  .stat-val {
    font-weight: 700;
    color: var(--accent);
  }

  .stat-lbl {
    font-weight: 400;
    color: var(--text-muted);
    text-transform: lowercase;
  }

  .product-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.6rem;
  }

  .tech-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 500;
    color: var(--tag-text);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .product-actions {
    display: flex;
    gap: 0.75rem;
  }

  .product-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.2s ease;
  }

  .product-link:hover {
    color: var(--accent);
  }

  /* Big icon on the right */
  .product-icon-area {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    opacity: 0.15;
    transition: opacity 0.2s ease;
  }

  .product-icon-area i {
    font-size: 3rem;
  }

  .product-card:hover .product-icon-area {
    opacity: 0.25;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .products-section {
      padding: 3rem 0;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .product-body {
      padding: 1rem 1.25rem;
      gap: 1rem;
    }

    .product-name {
      font-size: 1.05rem;
    }

    .product-icon-area {
      width: 48px;
      height: 48px;
    }

    .product-icon-area i {
      font-size: 2.25rem;
    }
  }
</style>
