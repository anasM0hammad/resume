---
import dice3dImg from '../assets/Projects/dice3d.png';
import threeVertexImg from '../assets/Projects/three-vertex.png';
import flyingBalloonImg from '../assets/Projects/flying-balloon.png';
import wakeaiImg from '../assets/Projects/wakeai.png';

interface Product {
  name: string;
  tagline: string;
  category: string;
  image: ImageMetadata;
  status: string;
  highlights: { label: string; value: string }[];
  stats: { label: string; value: string }[];
  tech: string[];
  sourceUrl?: string;
  liveUrl?: string;
}

const products: Product[] = [
  {
    name: "Dice 3D",
    tagline: "A 3D interactive dice roller with realistic physics, customizable face values, uploadable face images, and multiple dice skins. Available cross-platform on web, Android, and iOS with RPG dice support, daily challenges, and rich theme options.",
    category: "Mobile App",
    image: dice3dImg,
    status: "Shipped",
    highlights: [
      { label: "MRR", value: "$0" },
      { label: "Downloads", value: "100+" },
    ],
    stats: [
      { label: "Version", value: "v3.0.2" },
    ],
    tech: ["Three.js", "React", "Capacitor", "Typescript"],
    sourceUrl: "https://play.google.com/store/apps/details?id=com.anaslyzer.thedice",
  },
  {
    name: "Three Vertex",
    tagline: "A 3D collaboration platform with support for viewing, uploading and sharing any 3D model. It supports model listing, user authentication and model management with inbuilt 3D model viewer. It let user annotate on the model with hotspot and realtime feedback",
    category: "Web Platform",
    image: threeVertexImg,
    status: "Shipped",
    highlights: [
      { label: "MRR", value: "$0" },
      { label: "Models", value: "10+" },
    ],
    stats: [
      { label: "Version", value: "v2.0.0" },
    ],
    tech: ["Three.js", "Next.js", "Cloudflare", "Firebase", "R3F", "Typescript"],
    sourceUrl: "https://spaces.threevertex.co/",
  },
  {
    name: "Flying Balloon",
    tagline: "A fast-paced tap-to-fly arcade game where you navigate a balloon through moving obstacles while collecting coins and unlocking skins. Features daily rewards, badge achievements, a local leaderboard, and progressive difficulty scaling.",
    category: "Mobile Game",
    image: flyingBalloonImg,
    status: "Shipped",
    highlights: [
      { label: "MRR", value: "$0" },
      { label: "Downloads", value: "10+" },
    ],
    stats: [
      { label: "Version", value: "v1.3.0" },
    ],
    tech: ["Phaser 3", "React", "Capacitor", "Typescript"],
    sourceUrl: "https://play.google.com/store/apps/details?id=com.anaslyzer.flyingBalloon",
  },
  {
    name: "WakeAI",
    tagline: "An intelligent alarm clock that uses on-device AI to generate quiz questions you must solve before the alarm stops. Supports multiple difficulty levels, offline functionality, and adaptive model selection based on your device's capabilities.",
    category: "Mobile App",
    image: wakeaiImg,
    status: "Development",
    highlights: [
      { label: "MRR", value: "$0" },
      { label: "Downloads", value: "--" },
    ],
    stats: [
      { label: "Version", value: "1.0.0-beta" },
    ],
    tech: ["JavaScript", "React", "WebLLM", "OpenAI SDK", "Capacitor", "AI"],
    sourceUrl: "https://github.com/anasM0hammad/wake-ai",
  },
];
---

<section class="products-section">
  <div class="container-bg">
    <h3 class="section-header">
      <span class="prompt">&gt;</span> ls ~/products<span class="terminal-cursor"></span>
    </h3>

    <div class="products-grid">
      {products.map((product) => (
        <div class="product-card" data-href={product.sourceUrl || "#"}>
          <div class="product-body">
            <div class="product-info">
              <div class="product-name-row">
                <h3 class="product-name">{product.name}</h3>
                <span class="product-status" data-status={product.status}>{product.status}</span>
                <div class="product-highlights">
                  {product.highlights.map((h) => (
                    <div class="highlight-item">
                      <span class="highlight-val">{h.value}</span>
                      <span class="highlight-lbl">{h.label}</span>
                    </div>
                  ))}
                </div>
              </div>
              <span class="product-category">{product.category}</span>
              <p class="product-tagline">{product.tagline}</p>
              {product.stats.length > 0 && (
                <div class="product-stats">
                  {product.stats.map((stat) => (
                    <span class="stat-item">
                      <span class="stat-val">{stat.value}</span>
                      <span class="stat-lbl">{stat.label}</span>
                    </span>
                  ))}
                </div>
              )}
              <div class="product-tech">
                {product.tech.map((t) => (
                  <span class="tech-pill">{t}</span>
                ))}
              </div>
            </div>
            <div class="product-icon-area">
              <img src={product.image.src} alt={product.name} class="product-logo" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.product-card[data-href]').forEach((card) => {
    card.addEventListener('click', () => {
      const href = card.getAttribute('data-href');
      if (href && href !== '#') window.open(href, '_blank');
    });
  });
</script>

<style>
  .products-section {
    padding: 4rem 0;
    background: var(--bg-secondary);
    transition: background-color 0.3s ease;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s ease, transform 0.2s ease;
    cursor: pointer;
  }

  .product-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  /* ── Highlights inline in title row ── */
  .product-highlights {
    display: flex;
    gap: 1rem;
    margin-left: auto;
  }

  .highlight-item {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }

  .highlight-val {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .highlight-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    gap: 1.5rem;
  }

  .product-info {
    flex: 1;
    min-width: 0;
  }

  .product-name-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.15rem;
  }

  .product-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .product-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    white-space: nowrap;
  }

  .product-status[data-status="Development"] {
    color: #4a9eff;
    border: 1px solid rgba(74, 158, 255, 0.3);
  }

  .product-status[data-status="Shipped"] {
    color: #27c93f;
    border: 1px solid rgba(39, 201, 63, 0.3);
  }

  .product-status[data-status="Beta"] {
    color: #ffbd2e;
    border: 1px solid rgba(255, 189, 46, 0.3);
  }

  .product-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .product-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin: 0.4rem 0 0.6rem 0;
    line-height: 1.5;
  }

  .product-stats {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
  }

  .stat-val {
    font-weight: 700;
    color: var(--accent);
  }

  .stat-lbl {
    font-weight: 400;
    color: var(--text-muted);
    text-transform: lowercase;
  }

  .product-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.6rem;
  }

  .tech-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    font-weight: 500;
    color: var(--tag-text);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .product-actions {
    display: flex;
    gap: 0.75rem;
  }

  .product-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.2s ease;
  }

  .product-link:hover {
    color: var(--accent);
  }

  /* Product logo on the right */
  .product-icon-area {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .product-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
  }

  .product-card:hover .product-icon-area {
    opacity: 1;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .products-section {
      padding: 3rem 0;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .product-body {
      padding: 1rem;
      gap: 0.75rem;
    }

    .product-name-row {
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .product-highlights {
      margin-left: 0;
      width: 100%;
      gap: 0.75rem;
    }

    .product-name {
      font-size: 1.05rem;
    }

    .product-tagline {
      font-size: 0.75rem;
    }

    .product-icon-area {
      width: 48px;
      height: 48px;
    }

    .highlight-val {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .product-body {
      padding: 0.85rem;
    }

    .product-name {
      font-size: 0.95rem;
    }

    .product-tagline {
      font-size: 0.72rem;
    }

    .tech-pill {
      font-size: 0.52rem;
    }
  }
</style>
