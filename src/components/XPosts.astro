---
import { Image } from 'astro:assets';
import profileImg from '../assets/profile.png';

interface Tweet {
  text: string;
  date: string;
  likes: string;
  retweets: string;
  replies: string;
  views: string;
  url: string;
}

const tweets: Tweet[] = [
  {
    text: "Built a Chrome extension that fills job forms using AI. Langchain + RAG + OpenAI doing the heavy lifting. Open sourced it 🔗",
    date: "3:42 PM · Jan 15, 2025",
    likes: "24",
    retweets: "5",
    replies: "3",
    views: "1.2K",
    url: "https://x.com/anaslyzer",
  },
  {
    text: "Hot take: The best code you write is the code you delete. Shipped a feature today by removing 400 lines.",
    date: "11:20 AM · Dec 28, 2024",
    likes: "89",
    retweets: "12",
    replies: "7",
    views: "4.5K",
    url: "https://x.com/anaslyzer",
  },
  {
    text: "Solidity tip: Always check for reentrancy before external calls. Learned this the hard way building dMed 💀",
    date: "9:15 PM · Nov 10, 2024",
    likes: "42",
    retweets: "8",
    replies: "5",
    views: "2.1K",
    url: "https://x.com/anaslyzer",
  },
  {
    text: "4 years at Adobe and the biggest lesson? Ship fast, iterate faster. Perfect is the enemy of shipped.",
    date: "2:30 PM · Oct 5, 2024",
    likes: "156",
    retweets: "23",
    replies: "14",
    views: "8.7K",
    url: "https://x.com/anaslyzer",
  },
  {
    text: "Just crossed 50+ NFT health records on dMed testnet. Decentralized healthcare is closer than you think 🏥⛓️",
    date: "6:45 PM · Sep 18, 2024",
    likes: "38",
    retweets: "7",
    replies: "4",
    views: "1.8K",
    url: "https://x.com/anaslyzer",
  },
  {
    text: "If you're not using TypeScript in 2024, you're writing bugs for free. Strict mode + exhaustive checks = peace of mind.",
    date: "10:00 AM · Aug 22, 2024",
    likes: "112",
    retweets: "18",
    replies: "21",
    views: "6.3K",
    url: "https://x.com/anaslyzer",
  },
];
---

<section class="x-section">
  <div class="container-bg">
    <h3 class="section-header">
      <span class="prompt">&gt;</span> curl api.x.com/anaslyzer<span class="terminal-cursor"></span>
    </h3>

    <div class="x-grid">
      {tweets.map((tweet) => (
        <a href={tweet.url} target="_blank" rel="noopener" class="x-tweet">
          <div class="x-tweet__header">
            <Image src={profileImg} alt="Anas" class="x-tweet__avatar" width={36} height={36} />
            <div class="x-tweet__author">
              <div class="x-tweet__name-row">
                <span class="x-tweet__name">Anas</span>
                <svg class="x-tweet__verified" viewBox="0 0 22 22" width="14" height="14">
                  <path d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.69-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.636.433 1.221.878 1.69.47.446 1.055.752 1.69.883.635.13 1.294.083 1.902-.143.271.586.702 1.084 1.24 1.438.54.354 1.167.551 1.813.568.647-.016 1.276-.213 1.817-.567s.972-.854 1.245-1.44c.604.225 1.261.276 1.894.146.633-.13 1.218-.434 1.69-.88.445-.47.749-1.055.878-1.691.13-.634.08-1.292-.143-1.898.587-.272 1.087-.702 1.443-1.241.355-.54.553-1.169.57-1.816zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z" fill="#1d9bf0"/>
                </svg>
              </div>
              <span class="x-tweet__handle">@anaslyzer</span>
            </div>
            <svg class="x-tweet__xlogo" viewBox="0 0 24 24" width="18" height="18">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"/>
            </svg>
          </div>

          <p class="x-tweet__text">{tweet.text}</p>

          <div class="x-tweet__footer">
            <span class="x-tweet__date">{tweet.date}</span>
            <div class="x-tweet__actions">
              <span class="x-tweet__action x-tweet__action--reply">
                <svg viewBox="0 0 24 24" width="14" height="14"><path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z" fill="currentColor"/></svg>
                {tweet.replies}
              </span>
              <span class="x-tweet__action x-tweet__action--retweet">
                <svg viewBox="0 0 24 24" width="14" height="14"><path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z" fill="currentColor"/></svg>
                {tweet.retweets}
              </span>
              <span class="x-tweet__action x-tweet__action--like">
                <svg viewBox="0 0 24 24" width="14" height="14"><path d="M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91zm4.187 7.69c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.601 3.01.896 1.81.846 4.17-.514 6.67z" fill="currentColor"/></svg>
                {tweet.likes}
              </span>
              <span class="x-tweet__action x-tweet__action--views">
                <svg viewBox="0 0 24 24" width="14" height="14"><path d="M8.75 21V3h2v18h-2zM18.75 21V8.5h2V21h-2zM13.75 21v-9h2v9h-2zM3.75 21v-4h2v4h-2z" fill="currentColor"/></svg>
                {tweet.views}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <a href="https://x.com/anaslyzer" target="_blank" rel="noopener" class="x-follow">
      <svg viewBox="0 0 24 24" width="14" height="14"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"/></svg>
      Follow me on X
    </a>
  </div>
</section>

<style>
  .x-section {
    padding: 4rem 0;
    background: var(--bg-primary);
    transition: background-color 0.3s ease;
  }

  /* ── Simple 3-col grid ── */
  .x-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    max-width: 1050px;
    margin: 0 auto;
  }

  /* ── X dark mode tweet card ── */
  .x-tweet {
    background: #16181c;
    border: 1px solid #2f3336;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.15s ease;
  }

  .x-tweet:hover {
    background: #1d1f23;
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  /* ── Follow link ── */
  .x-follow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: #e7e9ea;
    background: #16181c;
    border: 1px solid #2f3336;
    padding: 0.45rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .x-follow:hover {
    background: #1d1f23;
    color: #1d9bf0;
  }

  /* ── Header ── */
  .x-tweet__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .x-tweet__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .x-tweet__author {
    flex: 1;
    min-width: 0;
  }

  .x-tweet__name-row {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .x-tweet__name {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: #e7e9ea;
    line-height: 1.2;
  }

  .x-tweet__verified { flex-shrink: 0; }

  .x-tweet__handle {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.72rem;
    color: #71767b;
    line-height: 1.2;
  }

  .x-tweet__xlogo {
    color: #e7e9ea;
    flex-shrink: 0;
    margin-left: auto;
  }

  /* ── Tweet text ── */
  .x-tweet__text {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.8rem;
    color: #e7e9ea;
    line-height: 1.4;
    margin: 0 0 0.5rem 0;
    flex: 1;
  }

  /* ── Footer: date + actions in one row ── */
  .x-tweet__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #2f3336;
    padding-top: 0.4rem;
  }

  .x-tweet__date {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.65rem;
    color: #71767b;
  }

  .x-tweet__actions {
    display: flex;
    gap: 0.75rem;
  }

  .x-tweet__action {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.68rem;
    color: #71767b;
    transition: color 0.15s ease;
  }

  .x-tweet__action svg {
    fill: #71767b;
    transition: fill 0.15s ease;
  }

  .x-tweet:hover .x-tweet__action--reply { color: #1d9bf0; }
  .x-tweet:hover .x-tweet__action--reply svg { fill: #1d9bf0; }
  .x-tweet:hover .x-tweet__action--retweet { color: #00ba7c; }
  .x-tweet:hover .x-tweet__action--retweet svg { fill: #00ba7c; }
  .x-tweet:hover .x-tweet__action--like { color: #f91880; }
  .x-tweet:hover .x-tweet__action--like svg { fill: #f91880; }
  .x-tweet:hover .x-tweet__action--views { color: #1d9bf0; }
  .x-tweet:hover .x-tweet__action--views svg { fill: #1d9bf0; }

  /* ── Responsive ── */
  @media (max-width: 992px) {
    .x-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .x-section { padding: 3rem 0; }
    .x-grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
